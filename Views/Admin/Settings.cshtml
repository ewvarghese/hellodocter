@{ ViewData["Title"] = "Settings"; }
<div class="w-full flex-grow flex flex-col py-6 px-2">
    <div class="max-w-4xl mx-auto w-full space-y-8 animate-in fade-in duration-500">
        <h3 class="text-2xl font-black text-slate-800 flex items-center gap-3">
            <i data-lucide="settings" class="text-[#f26522]"></i> Settings
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
            <div class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm">
                <div class="flex items-center gap-3 mb-6 border-b border-slate-100 pb-4">
                    <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center"><i data-lucide="calendar"></i></div>
                    <h4 class="font-black text-slate-800 text-lg">Day Count</h4>
                </div>
                
                <form action="/Admin/UpdateDayCount" method="post" class="space-y-4">
                    <div>
                        <label class="block text-xs font-black text-slate-500 uppercase tracking-widest mb-2">Number of days to accept booking</label>
                        <input type="number" name="dayCount" value="@ViewBag.DayCount" required min="1" class="w-full px-5 py-3.5 bg-white border border-slate-200 rounded-xl text-sm font-bold text-slate-800 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all shadow-sm hover:border-slate-300">
                    </div>
                    <button type="submit" class="w-full bg-[#10b981] hover:bg-emerald-600 text-white px-6 py-3 rounded-xl font-bold shadow-md transition-colors flex items-center justify-center gap-2">
                        <i data-lucide="save" class="w-4 h-4"></i> Update Days
                    </button>
                </form>
            </div>

      
            <div class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm">
                <div class="flex items-center gap-3 mb-6 border-b border-slate-100 pb-4">
                    <div class="w-10 h-10 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center"><i data-lucide="clock"></i></div>
                    <h4 class="font-black text-slate-800 text-lg">Hours Count</h4>
                </div>
                
                <form action="/Admin/UpdateHourCount" method="post" class="space-y-4">
                    <div>
                        <label class="block text-xs font-black text-slate-500 uppercase tracking-widest mb-2">Prevent booking before (Hours)</label>
                        <input type="number" name="hourCount" value="@ViewBag.HourCount" required min="0" class="w-full px-5 py-3.5 bg-white border border-slate-200 rounded-xl text-sm font-bold text-slate-800 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all shadow-sm hover:border-slate-300">
                    </div>
                    <button type="submit" class="w-full bg-[#10b981] hover:bg-emerald-600 text-white px-6 py-3 rounded-xl font-bold shadow-md transition-colors flex items-center justify-center gap-2">
                        <i data-lucide="save" class="w-4 h-4"></i> Update Hours
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
