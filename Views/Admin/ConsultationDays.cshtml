@{ ViewData["Title"] = "Consultation Days"; }
<div class="w-full flex-grow flex flex-col py-6 px-2">
    <div class="max-w-4xl mx-auto w-full space-y-8 animate-in fade-in duration-500">
        
        <h3 class="text-2xl font-black text-slate-800 flex items-center gap-3">
            <i data-lucide="calendar" class="text-[#f26522]"></i> Consultation Days
        </h3>

        @if (TempData["SuccessMsg"] != null)
        {
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-6 py-4 rounded-xl font-bold flex items-center gap-3">
                <i data-lucide="check-circle" class="w-5 h-5 shrink-0"></i> @TempData["SuccessMsg"]
            </div>
        }

 
        <div class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm">
            <h5 class="font-black text-slate-800 mb-6 flex items-center gap-2"><i data-lucide="plus-circle"></i> Add / Update Consultation Days</h5>
            
            <form action="/Admin/UpdateConsultationDays" method="post" class="space-y-6">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    @foreach (var wd in ViewBag.Weekdays)
                    {
                        bool isChecked = false;
                        if (ViewBag.MyDays != null)
                        {
                            foreach (var myDay in ViewBag.MyDays)
                            {
                                if (myDay.Dayid == wd.Dayid && myDay.Actv == true)
                                {
                                    isChecked = true;
                                    break;
                                }
                            }
                        }
                        
                        <label class="relative flex items-center justify-center p-4 border @(isChecked ? "border-[#f26522] bg-orange-50/50" : "border-slate-200 bg-slate-50") rounded-xl cursor-pointer hover:bg-slate-100 transition-colors group">
                            <input type="checkbox" name="selectedDays" value="@wd.Dayid" @(isChecked ? "checked" : "") class="absolute opacity-0 w-0 h-0 peer">
                            <span class="text-sm font-bold @(isChecked ? "text-[#f26522]" : "text-slate-600")">@wd.Days</span>
                            <div class="absolute inset-0 border-2 border-transparent peer-checked:border-[#f26522] rounded-xl pointer-events-none transition-colors"></div>
                        </label>
                    }
                </div>
                
                <div class="pt-6 border-t border-slate-100">
                    <button type="submit" class="bg-[#10b981] hover:bg-emerald-600 text-white px-8 py-3 rounded-xl font-bold shadow-md transition-colors flex items-center gap-2">
                        <i data-lucide="save" class="w-4 h-4"></i> Submit Changes
                    </button>
                </div>
            </form>
        </div>

       
        <div class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200">
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest w-16">Sl</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Day</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest text-right">Add / List Slot</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm font-semibold text-slate-700">
                        @if (ViewBag.ActiveDaysList != null && ViewBag.ActiveDaysList.Count > 0)
                        {
                            int index = 1;
                            foreach (var item in ViewBag.ActiveDaysList)
                            {
                                <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition-colors">
                                    <td class="py-4 px-4 text-slate-400">@index</td>
                                    <td class="py-4 px-4">@item.Days</td>
                                    <td class="py-4 px-4 text-right">
                                        <a href="/Admin/Slots?cnid=@item.Cnid" class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white transition-colors shadow-sm">
                                            <i data-lucide="plus" class="w-4 h-4"></i>
                                        </a>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="py-12 text-center">
                                    <div class="text-red-500 font-bold text-lg mb-2">No Consultation Days Added</div>
                                    <p class="text-slate-400 text-sm">Select days from the form above to activate them.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('input[name="selectedDays"]').forEach(cb => {
            cb.addEventListener('change', function () {
                const label = this.closest('label');
                const span = label.querySelector('span');
                if (this.checked) {
                    label.classList.remove('border-slate-200', 'bg-slate-50');
                    label.classList.add('border-[#f26522]', 'bg-orange-50');
                    span.classList.remove('text-slate-600');
                    span.classList.add('text-[#f26522]');
                } else {
                    label.classList.remove('border-[#f26522]', 'bg-orange-50', 'bg-orange-50/50');
                    label.classList.add('border-slate-200', 'bg-slate-50');
                    span.classList.remove('text-[#f26522]');
                    span.classList.add('text-slate-600');
                }
            });
        });
    </script>
}
