@model IEnumerable<HelloDoctor.Care.Models.Doctor>
@{ 
    ViewData["Title"] = "Manage Doctors"; 
    var adminUsers = ViewBag.AdminUsers as Dictionary<int?, HelloDoctor.Care.Models.AdminUser>;
}

<div class="w-full flex-grow flex flex-col py-6 px-2">
    <div class="max-w-7xl mx-auto w-full space-y-8 animate-in fade-in duration-500">
        
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            <h3 class="text-2xl font-black text-slate-800 flex items-center gap-3">
                <i data-lucide="users" class="text-[#f26522]"></i> Manage Doctors
            </h3>
            <button type="button" onclick="document.getElementById('addModal').classList.remove('hidden')" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl font-bold shadow-md transition-colors flex items-center gap-2 shrink-0">
                <i data-lucide="plus" class="w-4 h-4"></i> Add Doctor
            </button>
        </div>

        @if (TempData["SuccessMsg"] != null) {
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-600 px-6 py-4 rounded-xl font-bold flex items-center gap-3">
                <i data-lucide="check-circle" class="w-5 h-5"></i> @TempData["SuccessMsg"]
            </div>
        }
        @if (TempData["ErrorMsg"] != null) {
            <div class="bg-red-50 border border-red-200 text-red-600 px-6 py-4 rounded-xl font-bold flex items-center gap-3">
                <i data-lucide="alert-circle" class="w-5 h-5"></i> @TempData["ErrorMsg"]
            </div>
        }

     
        <div class="bg-white border border-slate-200 rounded-[2rem] p-6 shadow-sm">
            <form method="get" action="/Admin/Doctors" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">District</label>
                    <select name="filterDid" id="filterDid" onchange="loadLocationsForFilter(); this.form.submit()" class="w-full bg-slate-50 px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 font-semibold text-slate-700">
                        <option value="0">-- All Districts --</option>
                        @if(ViewBag.Districts != null) {
                            foreach(var d in ViewBag.Districts) {
                                if(ViewBag.FilterDid == d.Did) { <option value="@d.Did" selected>@d.Dname</option> }
                                else { <option value="@d.Did">@d.Dname</option> }
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Location</label>
                    <select name="filterCid" id="filterCid" onchange="this.form.submit()" class="w-full bg-slate-50 px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 font-semibold text-slate-700">
                        <option value="0">-- All Locations --</option>
                        @if(ViewBag.Locations != null) {
                            foreach(var l in ViewBag.Locations) {
                                if(ViewBag.FilterCid == l.Cid) { <option value="@l.Cid" selected>@l.Cname</option> }
                                else { <option value="@l.Cid">@l.Cname</option> }
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Department</label>
                    <select name="filterDepid" onchange="this.form.submit()" class="w-full bg-slate-50 px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 font-semibold text-slate-700">
                        <option value="0">-- All Departments --</option>
                        @if(ViewBag.Departments != null) {
                            foreach(var dp in ViewBag.Departments) {
                                if(ViewBag.FilterDepid == dp.Depid) { <option value="@dp.Depid" selected>@dp.Depname</option> }
                                else { <option value="@dp.Depid">@dp.Depname</option> }
                            }
                        }
                    </select>
                </div>
                <div>
                    <a href="/Admin/Doctors" class="w-full inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 text-slate-600 px-5 py-2.5 rounded-xl font-bold transition-colors">Clear Filters</a>
                </div>
            </form>
        </div>
         
        <div class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse whitespace-nowrap">
                    <thead>
                        <tr class="border-b border-slate-200">
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest w-12">Sl</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Doctor</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Username</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Department</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest text-center">Days</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest text-center">Payment</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest text-center">Status</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest text-center">Options</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm font-semibold text-slate-700">
                        @if (Model != null && Model.Any()) {
                            int index = 1;
                            foreach (var item in Model) {
                                var aUser = adminUsers != null && adminUsers.ContainsKey(item.Drid) ? adminUsers[item.Drid] : null;
                                string userName = aUser != null ? item.Mob2 : item.Mob2;
                                string whatsappId = aUser != null ? aUser.Drcode : "";
                                int roleId = aUser != null ? (aUser.Roleid ?? 0) : 0;
                                
                                <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition-colors">
                                    <td class="py-4 px-4 text-slate-400">@index</td>
                                    <td class="py-4 px-4">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-full bg-slate-100 overflow-hidden shrink-0">
                                                <img src="@(!string.IsNullOrEmpty(item.Photo) ? "/images/" + item.Photo : "https://ui-avatars.com/api/?name=Dr")" class="w-full h-full object-cover" />
                                            </div>
                                            <div>
                                                <div class="font-black text-slate-900">@item.Drname</div>
                                                <div class="text-xs text-slate-500">@item.Designation</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-4">
                                        <span class="px-2 py-1 bg-slate-100 rounded text-xs">@userName</span>
                                    </td>
                                    <td class="py-4 px-4 text-slate-600">@(item.Department?.Depname ?? "N/A")</td>
                                    <td class="py-4 px-4 text-center">
                                        <a href="/Admin/ConsultationDays?drid=@item.Drid" class="inline-flex items-center justify-center p-2 rounded-lg bg-blue-50 text-blue-500 hover:bg-blue-100 transition-colors" title="View Days">
                                            <i data-lucide="eye" class="w-4 h-4"></i>
                                        </a>
                                    </td>
                                    <td class="py-4 px-4 text-center">
                                        <a href="/Admin/ToggleDoctorPayment/@item.Drid" title="Toggle Payment Required">
                                            @if (item.Payment == true) {
                                                <span class="inline-flex items-center justify-center p-1.5 rounded-lg bg-emerald-50 text-emerald-500 hover:bg-emerald-100 transition-colors"><i data-lucide="check-circle" class="w-5 h-5"></i></span>
                                            } else {
                                                <span class="inline-flex items-center justify-center p-1.5 rounded-lg bg-slate-50 text-slate-400 hover:bg-slate-100 transition-colors"><i data-lucide="x-circle" class="w-5 h-5"></i></span>
                                            }
                                        </a>
                                    </td>
                                    <td class="py-4 px-4 text-center">
                                        <a href="/Admin/ToggleDoctorActv/@item.Drid" title="Toggle Active Status">
                                            @if (item.Actv == true) {
                                                <span class="inline-flex items-center justify-center p-1.5 rounded-lg bg-emerald-50 text-emerald-500 hover:bg-emerald-100 transition-colors"><i data-lucide="check-circle" class="w-5 h-5"></i></span>
                                            } else {
                                                <span class="inline-flex items-center justify-center p-1.5 rounded-lg bg-slate-50 text-slate-400 hover:bg-slate-100 transition-colors"><i data-lucide="x-circle" class="w-5 h-5"></i></span>
                                            }
                                        </a>
                                    </td>
                                    <td class="py-4 px-4 text-center flex items-center justify-center gap-2">
                                        @{
                                           
                                            var docData = new {
                                                Drid = item.Drid, Did = item.Did, Cid = item.Cid, Depid = item.Depid, Roleid = roleId,
                                                Drname = item.Drname, Designation = item.Designation, Username = userName,
                                                Whatsapp = whatsappId, Address = item.Address, Hospital = item.WorkingHospital,
                                                Email = item.Email, Mob1 = item.Mob1, Cfee = item.cfee, Photo = item.Photo
                                            };
                                            var jsonStr = Newtonsoft.Json.JsonConvert.SerializeObject(docData);
                                        }
                                        <button type="button" onclick='openEditModal(@Html.Raw(jsonStr))' class="p-2 rounded-lg bg-blue-50 text-blue-500 hover:bg-blue-500 hover:text-white transition-colors" title="Edit">
                                            <i data-lucide="edit" class="w-4 h-4"></i>
                                        </button>
                                        <form action="/Admin/DeleteDoctor" method="post" onsubmit="return confirm('Are you sure you want to delete this doctor?');">
                                            <input type="hidden" name="id" value="@item.Drid" />
                                            <button type="submit" class="p-2 rounded-lg bg-red-50 text-red-500 hover:bg-red-500 hover:text-white transition-colors" title="Delete">
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                index++;
                            }
                        } else {
                            <tr><td colspan="8" class="py-8 text-center text-slate-400">No doctors found matching criteria.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

 
<div id="addModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[100] flex items-center justify-center p-4">
    <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-4xl max-h-[90vh] flex flex-col overflow-hidden animate-in zoom-in-95 duration-200">
        <div class="px-8 py-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50 shrink-0">
            <h3 class="font-black text-slate-800 text-xl">Add Doctor</h3>
            <button type="button" onclick="document.getElementById('addModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-6 h-6"></i></button>
        </div>
        <div class="p-8 overflow-y-auto flex-1">
            <form action="/Admin/AddManageDoctor" method="post" enctype="multipart/form-data" class="space-y-6" onsubmit="return validateAddForm()">
                
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">District <span class="text-red-500">*</span></label>
                        <select name="Did" id="addDid" required onchange="loadLocationsForAdd(this.value)" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 font-semibold">
                            <option value="">--Select District--</option>
                            @if(ViewBag.Districts != null) {
                                foreach(var d in ViewBag.Districts) { <option value="@d.Did">@d.Dname</option> }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Location <span class="text-red-500">*</span></label>
                        <select name="Cid" id="addCid" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 font-semibold">
                            <option value="">--Select Location--</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Department <span class="text-red-500">*</span></label>
                        <select name="Depid" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 font-semibold">
                            <option value="">--Select Department--</option>
                            @if(ViewBag.Departments != null) {
                                foreach(var d in ViewBag.Departments) { <option value="@d.Depid">@d.Depname</option> }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Role <span class="text-red-500">*</span></label>
                        <select name="Roleid" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 font-semibold">
                            <option value="">--Select Role--</option>
                            @if(ViewBag.Roles != null) {
                                foreach(var r in ViewBag.Roles) { <option value="@r.Roleid">@r.Rolename</option> }
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Dr. Name <span class="text-red-500">*</span></label>
                        <input type="text" name="Drname" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Designation</label>
                        <input type="text" name="Designation" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2 flex justify-between">
                            <span>Username <span class="text-red-500">*</span></span>
                            <span id="addUsernameMsg" class="text-xs"></span>
                        </label>
                        <input type="text" name="Mob2" id="addUsername" required onblur="checkUsername(this.value, 'addUsernameMsg')" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2 flex justify-between">
                            <span>Whatsapp ID <span class="text-red-500">*</span></span>
                            <span id="addWhatsappMsg" class="text-xs"></span>
                        </label>
                        <input type="text" name="Drcode" id="addWhatsapp" required onblur="checkWhatsapp(this.value, 'addWhatsappMsg')" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-sm font-bold text-slate-700 mb-2">Address</label>
                        <textarea name="Address" rows="2" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"></textarea>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Working Hospital</label>
                        <input type="text" name="WorkingHospital" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Consultation Fee (₹)</label>
                        <input type="number" name="cfee" min="0" value="300" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Email <span class="text-red-500">*</span></label>
                        <input type="email" name="Email" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Mobile (Also sets initial password) <span class="text-red-500">*</span></label>
                        <input type="tel" name="Mob1" required pattern="[0-9]{10}" placeholder="10 digit number" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
                    </div>

                    <div class="md:col-span-2 flex items-center gap-6 bg-slate-50 p-4 rounded-2xl border border-slate-200">
                        <img id="addPhotoPreview" src="https://ui-avatars.com/api/?name=Dr&background=cbd5e1" class="w-20 h-20 rounded-xl object-cover border border-slate-300" />
                        <div class="flex-1">
                            <label class="block text-sm font-bold text-slate-700 mb-2">Profile Photo <span class="text-red-500">*</span></label>
                            <input type="file" name="filedoctor" accept="image/*" required onchange="previewImage(this, 'addPhotoPreview')" class="w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                        </div>
                    </div>
                </div>

                <div class="pt-6 border-t border-slate-100 flex justify-end gap-3 mt-8">
                    <button type="button" onclick="document.getElementById('addModal').classList.add('hidden')" class="px-6 py-3 font-bold text-slate-500 hover:bg-slate-50 rounded-xl transition-colors">Cancel</button>
                    <button type="submit" id="addSubmitBtn" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-xl font-bold shadow-md transition-colors">Submit Doctor</button>
                </div>
            </form>
        </div>
    </div>
</div>

 
<div id="editModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[100] flex items-center justify-center p-4">
    <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-4xl max-h-[90vh] flex flex-col overflow-hidden animate-in zoom-in-95 duration-200">
        <div class="px-8 py-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50 shrink-0">
            <h3 class="font-black text-slate-800 text-xl">Edit Doctor</h3>
            <button type="button" onclick="document.getElementById('editModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-6 h-6"></i></button>
        </div>
        <div class="p-8 overflow-y-auto flex-1">
            <form action="/Admin/UpdateManageDoctor" method="post" enctype="multipart/form-data" class="space-y-6">
                <input type="hidden" name="Drid" id="editDrid" />
                
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">District <span class="text-red-500">*</span></label>
                        <select name="Did" id="editDid" required onchange="loadLocationsForEdit(this.value, null)" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 font-semibold">
                            <option value="">--Select District--</option>
                            @if(ViewBag.Districts != null) {
                                foreach(var d in ViewBag.Districts) { <option value="@d.Did">@d.Dname</option> }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Location <span class="text-red-500">*</span></label>
                        <select name="Cid" id="editCid" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 font-semibold">
                            <option value="">--Select Location--</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Department <span class="text-red-500">*</span></label>
                        <select name="Depid" id="editDepid" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 font-semibold">
                            <option value="">--Select Department--</option>
                            @if(ViewBag.Departments != null) {
                                foreach(var d in ViewBag.Departments) { <option value="@d.Depid">@d.Depname</option> }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Role <span class="text-red-500">*</span></label>
                        <select name="Roleid" id="editRoleid" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 font-semibold">
                            <option value="">--Select Role--</option>
                            @if(ViewBag.Roles != null) {
                                foreach(var r in ViewBag.Roles) { <option value="@r.Roleid">@r.Rolename</option> }
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Dr. Name <span class="text-red-500">*</span></label>
                        <input type="text" name="Drname" id="editDrname" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Designation</label>
                        <input type="text" name="Designation" id="editDesignation" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2 flex justify-between">
                            <span>Username (Cannot be changed here)</span>
                        </label>
                        <input type="text" id="editUsername" disabled readonly class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-100 text-slate-500 font-semibold">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2 flex justify-between">
                            <span>Whatsapp ID <span class="text-red-500">*</span></span>
                        </label>
                        <input type="text" name="Drcode" id="editWhatsapp" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-sm font-bold text-slate-700 mb-2">Address</label>
                        <textarea name="Address" id="editAddress" rows="2" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"></textarea>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Working Hospital</label>
                        <input type="text" name="WorkingHospital" id="editHospital" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Consultation Fee (₹)</label>
                        <input type="number" name="cfee" id="editCfee" min="0" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Email <span class="text-red-500">*</span></label>
                        <input type="email" name="Email" id="editEmail" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Mobile (Updates password) <span class="text-red-500">*</span></label>
                        <input type="tel" name="Mob1" id="editMob1" required pattern="[0-9]{10}" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
                    </div>

                    <div class="md:col-span-2 flex items-center gap-6 bg-slate-50 p-4 rounded-2xl border border-slate-200">
                        <img id="editPhotoPreview" src="https://ui-avatars.com/api/?name=Dr&background=cbd5e1" class="w-20 h-20 rounded-xl object-cover border border-slate-300" />
                        <div class="flex-1">
                            <label class="block text-sm font-bold text-slate-700 mb-2">Change Photo (Leave empty to keep current)</label>
                            <input type="file" name="fileuploaddred" accept="image/*" onchange="previewImage(this, 'editPhotoPreview')" class="w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                        </div>
                    </div>
                </div>

                <div class="pt-6 border-t border-slate-100 flex justify-end gap-3 mt-8">
                    <button type="button" onclick="document.getElementById('editModal').classList.add('hidden')" class="px-6 py-3 font-bold text-slate-500 hover:bg-slate-50 rounded-xl transition-colors">Cancel</button>
                    <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white px-8 py-3 rounded-xl font-bold shadow-md transition-colors">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
<script>
    lucide.createIcons();

     
    function loadLocationsForFilter() {
        const did = document.getElementById('filterDid').value;
        const cidSelect = document.getElementById('filterCid');
        cidSelect.innerHTML = '<option value="0">-- All Locations --</option>';
        if(did > 0) fetchLocations(did, cidSelect, null);
    }

    
    function loadLocationsForAdd(did) {
        const cidSelect = document.getElementById('addCid');
        cidSelect.innerHTML = '<option value="">--Select Location--</option>';
        if(did > 0) fetchLocations(did, cidSelect, null);
    }

     
    function loadLocationsForEdit(did, selectedCid) {
        const cidSelect = document.getElementById('editCid');
        cidSelect.innerHTML = '<option value="">--Select Location--</option>';
        if(did > 0) fetchLocations(did, cidSelect, selectedCid);
    }

    function fetchLocations(did, selectElement, selectedCid) {
        fetch(`/Admin/GetLocationsByDistrict?did=${did}`)
            .then(res => res.json())
            .then(data => {
                data.forEach(loc => {
                    const opt = document.createElement('option');
                    opt.value = loc.cid;
                    opt.textContent = loc.name;
                    if (selectedCid && selectedCid == loc.cid) opt.selected = true;
                    selectElement.appendChild(opt);
                });
            });
    }

 
    function openEditModal(data) {
        document.getElementById('editDrid').value = data.Drid || '';
        document.getElementById('editDid').value = data.Did || '';
        document.getElementById('editDepid').value = data.Depid || '';
        document.getElementById('editRoleid').value = data.Roleid || '';
        document.getElementById('editDrname').value = data.Drname || '';
        document.getElementById('editDesignation').value = data.Designation || '';
        document.getElementById('editUsername').value = data.Username || '';
        document.getElementById('editWhatsapp').value = data.Whatsapp || '';
        document.getElementById('editAddress').value = data.Address || '';
        document.getElementById('editHospital').value = data.Hospital || '';
        document.getElementById('editEmail').value = data.Email || '';
        document.getElementById('editMob1').value = data.Mob1 || '';
        document.getElementById('editCfee').value = data.Cfee || 300;
        
        if (data.Photo) {
            document.getElementById('editPhotoPreview').src = "/images/" + data.Photo;
        } else {
            document.getElementById('editPhotoPreview').src = "https://ui-avatars.com/api/?name=Dr&background=cbd5e1";
        }

        loadLocationsForEdit(data.Did, data.Cid);
        document.getElementById('editModal').classList.remove('hidden');
    }

     
    function previewImage(input, imgId) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById(imgId).src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

     
    let isUsernameValid = false;
    let isWhatsappValid = false;

     
    function checkUsername(val, msgId) {
        if(!val) return;
        fetch('/Admin/CheckDoctorUserName', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: val })
        }).then(r => r.json()).then(isAvailable => {
            const msg = document.getElementById(msgId);
            if(isAvailable) { msg.textContent = "Available"; msg.className = "text-xs font-bold text-emerald-500"; isUsernameValid = true; }
            else { msg.textContent = "Taken! Choose another."; msg.className = "text-xs font-bold text-red-500"; isUsernameValid = false; }
        });
    }

    function checkWhatsapp(val, msgId) {
        if(!val) return;
        fetch('/Admin/CheckWhatsapid', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: val })
        }).then(r => r.json()).then(isAvailable => {
            const msg = document.getElementById(msgId);
            if(isAvailable) { msg.textContent = "Available"; msg.className = "text-xs font-bold text-emerald-500"; isWhatsappValid = true; }
            else { msg.textContent = "Taken! Choose another."; msg.className = "text-xs font-bold text-red-500"; isWhatsappValid = false; }
        });
    }

    function validateAddForm() {
        if(!isUsernameValid || !isWhatsappValid) {
            alert("Please ensure Username and Whatsapp ID are available before submitting.");
            return false;
        }
        return true;
    }
</script>
}