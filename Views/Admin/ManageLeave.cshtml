@{ ViewData["Title"] = "Manage Leave"; }
<div class="w-full flex-grow flex flex-col py-6 px-2">
    <div class="max-w-4xl mx-auto w-full space-y-8 animate-in fade-in duration-500">
        
        <h3 class="text-2xl font-black text-slate-800 flex items-center gap-3">
            <i data-lucide="calendar-off" class="text-[#f26522]"></i> Manage Leave
        </h3>

       
        <div class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm">
            <h5 class="font-black text-slate-800 mb-6 flex items-center gap-2"><i data-lucide="plus-circle"></i> Mark Leave</h5>
            
            <form action="/Admin/AddLeave" method="post" class="space-y-6">
                <div class="w-full md:w-1/2">
                    <p class="text-xs font-bold text-slate-700 mb-2">Select Date</p>
                    <input type="date" name="leaveDate" required min="@DateTime.Now.ToString("yyyy-MM-dd")" class="w-full px-5 py-3.5 bg-white border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all shadow-sm hover:border-slate-300">
                </div>
                
                <div class="pt-2">
                    <button type="submit" class="bg-[#10b981] hover:bg-emerald-600 text-white px-8 py-3 rounded-xl font-bold shadow-md transition-colors flex items-center gap-2">
                        <i data-lucide="save" class="w-4 h-4"></i> Submit Leave
                    </button>
                </div>
            </form>
        </div>

      
        <div class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm">
            <form action="/Admin/DeleteLeaves" method="post">
                <div class="flex justify-between items-center mb-6 pb-6 border-b border-slate-100">
                    <h5 class="font-black text-slate-800">Existing Leaves</h5>
                    <button type="submit" onclick="return confirm('Are you sure you want to delete selected leaves?');" class="bg-red-50 hover:bg-red-500 text-red-600 hover:text-white px-5 py-2.5 rounded-xl text-sm font-bold transition-colors flex items-center gap-2 border border-red-200 hover:border-transparent shadow-sm">
                        <i data-lucide="trash-2" class="w-4 h-4"></i> Delete Selected
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200">
                                <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest w-16">Sl</th>
                                <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest w-16">
                                    <input type="checkbox" id="selectAll" class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
                                </th>
                                <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Date</th>
                            </tr>
                        </thead>
                        <tbody class="text-sm font-semibold text-slate-700">
                            @if (Model != null && Model.Count > 0)
                            {
                                int index = 1;
                                foreach (var item in Model)
                                {
                                    <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition-colors">
                                        <td class="py-4 px-4 text-slate-400">@index</td>
                                        <td class="py-4 px-4">
                                            <input type="checkbox" name="selectedLeaves" value="@item.Lid" class="leave-checkbox w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
                                        </td>
                                        <td class="py-4 px-4 font-black">@item.Frmdt</td>
                                    </tr>
                                    index++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="py-12 text-center">
                                        <div class="text-emerald-500 font-bold text-lg mb-2">No Leaves Added</div>
                                        <p class="text-slate-400 text-sm">You are fully available.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
<script>
    document.getElementById('selectAll').addEventListener('change', function() {
        const checkboxes = document.querySelectorAll('.leave-checkbox');
        for (const checkbox of checkboxes) {
            checkbox.checked = this.checked;
        }
    });
</script>
}
