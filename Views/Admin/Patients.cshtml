@model IEnumerable<dynamic>
@{ ViewData["Title"] = "Payment Completed Patients"; }

<div class="w-full flex-grow flex flex-col py-6 px-2">
    <div class="max-w-6xl mx-auto w-full space-y-8 animate-in fade-in duration-500">
        
        <div class="flex items-center justify-between">
            <h3 class="text-2xl font-black text-slate-800 flex items-center gap-3">
                <i data-lucide="users" class="text-[#f26522]"></i> Payment Completed
            </h3>
        </div>

        @if (TempData["SuccessMsg"] != null) {
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-600 px-6 py-4 rounded-xl font-bold flex items-center gap-3">
                <i data-lucide="check-circle" class="w-5 h-5"></i> @TempData["SuccessMsg"]
            </div>
        }

        <div class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse whitespace-nowrap">
                    <thead>
                        <tr class="border-b border-slate-200">
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest w-16">Sl</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Patient</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Mobile</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Email</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Doctor</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Date</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm font-semibold text-slate-700">
                        @if (Model != null && Model.Any()) {
                            int index = 1;
                            foreach (var item in Model) {
                                <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition-colors">
                                    <td class="py-4 px-4 text-slate-400">@index</td>
                                    <td class="py-4 px-4 font-black">@item.PatientName</td>
                                    <td class="py-4 px-4">@item.Mobile</td>
                                    <td class="py-4 px-4">@item.Email</td>
                                    <td class="py-4 px-4">@item.DoctorName</td>
                                    <td class="py-4 px-4">@item.Date</td>
                                </tr>
                                index++;
                            }
                        } else {
                            <tr><td colspan="6" class="py-8 text-center text-slate-400">No patients found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    lucide.createIcons();
</script>
}