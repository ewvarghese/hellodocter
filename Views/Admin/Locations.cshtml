@model IEnumerable<HelloDoctor.Care.Models.Location>
@{ ViewData["Title"] = "Manage Locations"; }

<div class="w-full flex-grow flex flex-col py-6 px-2">
    <div class="max-w-6xl mx-auto w-full space-y-8 animate-in fade-in duration-500">
        
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <h3 class="text-2xl font-black text-slate-800 flex items-center gap-3">
                <i data-lucide="map" class="text-[#f26522]"></i> Manage Locations
            </h3>
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-3 bg-white px-3 py-1.5 rounded-xl border border-slate-200 shadow-sm">
                    <span class="text-xs font-bold text-slate-500 uppercase">District:</span>
                    <select id="districtFilter" onchange="window.location.href='/Admin/Locations?filterDid=' + this.value" class="bg-transparent text-sm font-bold text-slate-800 outline-none border-none cursor-pointer">
                        <option value="0">-- All Districts --</option>
                        @if(ViewBag.Districts != null) {
                            foreach(var d in ViewBag.Districts) {
                                if(ViewBag.FilterDid == d.Did) {
                                    <option value="@d.Did" selected>@d.Dname</option>
                                } else {
                                    <option value="@d.Did">@d.Dname</option>
                                }
                            }
                        }
                    </select>
                </div>
                <button type="button" onclick="document.getElementById('addModal').classList.remove('hidden')" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl font-bold shadow-md transition-colors flex items-center gap-2">
                    <i data-lucide="plus" class="w-4 h-4"></i> Add Location
                </button>
            </div>
        </div>

        @if (TempData["SuccessMsg"] != null) {
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-600 px-6 py-4 rounded-xl font-bold flex items-center gap-3">
                <i data-lucide="check-circle" class="w-5 h-5"></i> @TempData["SuccessMsg"]
            </div>
        }

        <div class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm">
            <form action="/Admin/UpdateLocationPriorities" method="post">
                <input type="hidden" name="filterDid" value="@ViewBag.FilterDid" />
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse whitespace-nowrap">
                        <thead>
                            <tr class="border-b border-slate-200">
                                <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest w-16">Sl</th>
                                <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Title</th>
                                <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">District</th>
                                <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest w-24">Priority</th>
                                <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest text-center w-24">Status</th>
                                <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest text-center w-24">Options</th>
                            </tr>
                        </thead>
                        <tbody class="text-sm font-semibold text-slate-700">
                            @if (Model != null && Model.Any()) {
                                int index = 1;
                                foreach (var item in Model) {
                                    <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition-colors">
                                        <td class="py-4 px-4 text-slate-400">@index</td>
                                        <td class="py-4 px-4 font-black">@item.Cname</td>
                                        <td class="py-4 px-4 text-slate-500">@(item.District?.Dname ?? "N/A")</td>
                                        <td class="py-4 px-4">
                                            <input type="hidden" name="cids" value="@item.Cid" />
                                            <input type="number" name="priorities" value="@item.Priority" class="w-16 px-2 py-1 border border-slate-300 rounded focus:outline-none focus:border-blue-500 text-center font-bold" />
                                        </td>
                                        <td class="py-4 px-4 text-center">
                                            <a href="/Admin/ToggleLocationStatus?id=@item.Cid&filterDid=@ViewBag.FilterDid" title="Toggle Status">
                                                @if (item.Actv == true) {
                                                    <span class="inline-flex items-center justify-center p-1.5 rounded-lg bg-emerald-50 text-emerald-500 hover:bg-emerald-100 transition-colors"><i data-lucide="check-circle" class="w-5 h-5"></i></span>
                                                } else {
                                                    <span class="inline-flex items-center justify-center p-1.5 rounded-lg bg-slate-50 text-slate-400 hover:bg-slate-100 transition-colors"><i data-lucide="x-circle" class="w-5 h-5"></i></span>
                                                }
                                            </a>
                                        </td>
                                        <td class="py-4 px-4 text-center flex items-center justify-center gap-2">
                                            <button type="button" onclick="openEditModal('@item.Cid', '@item.Did', '@Html.Raw(item.Cname?.Replace("'", "\\'"))')" class="p-2 rounded-lg bg-blue-50 text-blue-500 hover:bg-blue-500 hover:text-white transition-colors" title="Edit">
                                                <i data-lucide="edit" class="w-4 h-4"></i>
                                            </button>
                                            <button type="button" onclick="confirmDelete('@item.Cid')" class="p-2 rounded-lg bg-red-50 text-red-500 hover:bg-red-500 hover:text-white transition-colors" title="Delete">
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    index++;
                                }
                            } else {
                                <tr><td colspan="6" class="py-8 text-center text-slate-400">No locations found for this district.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-6 flex justify-end">
                    <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-xl font-bold shadow-md transition-colors flex items-center gap-2">
                        <i data-lucide="save" class="w-4 h-4"></i> Update Priority
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

 
<div id="addModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[100] flex items-center justify-center p-4">
    <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-md overflow-hidden animate-in zoom-in-95 duration-200">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <h3 class="font-black text-slate-800 text-lg">Add Location</h3>
            <button type="button" onclick="document.getElementById('addModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
        <form action="/Admin/AddLocation" method="post" class="p-6">
            <input type="hidden" name="filterDid" value="@ViewBag.FilterDid" />
            <div class="mb-4">
                <label class="block text-sm font-bold text-slate-700 mb-2">District</label>
                <select name="Did" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all font-semibold">
                    <option value="">--Select District--</option>
                    @if(ViewBag.Districts != null) {
                        foreach(var d in ViewBag.Districts) {
                            if(ViewBag.FilterDid == d.Did) {
                                <option value="@d.Did" selected>@d.Dname</option>
                            } else {
                                <option value="@d.Did">@d.Dname</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="mb-6">
                <label class="block text-sm font-bold text-slate-700 mb-2">Location Title</label>
                <input type="text" name="Cname" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all" placeholder="Enter location name">
            </div>
            <div class="flex justify-end gap-3">
                <button type="button" onclick="document.getElementById('addModal').classList.add('hidden')" class="px-5 py-2.5 font-bold text-slate-500 hover:bg-slate-50 rounded-xl transition-colors">Cancel</button>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-xl font-bold shadow-md transition-colors">Submit</button>
            </div>
        </form>
    </div>
</div>

 
<div id="editModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[100] flex items-center justify-center p-4">
    <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-md overflow-hidden animate-in zoom-in-95 duration-200">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <h3 class="font-black text-slate-800 text-lg">Edit Location</h3>
            <button type="button" onclick="document.getElementById('editModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
        <form action="/Admin/EditLocation" method="post" class="p-6">
            <input type="hidden" name="Cid" id="editCid" />
            <input type="hidden" name="filterDid" value="@ViewBag.FilterDid" />
            <div class="mb-4">
                <label class="block text-sm font-bold text-slate-700 mb-2">District</label>
                <select name="Did" id="editDid" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all font-semibold">
                    <option value="">--Select District--</option>
                    @if(ViewBag.Districts != null) {
                        foreach(var d in ViewBag.Districts) {
                            <option value="@d.Did">@d.Dname</option>
                        }
                    }
                </select>
            </div>
            <div class="mb-6">
                <label class="block text-sm font-bold text-slate-700 mb-2">Location Title</label>
                <input type="text" name="Cname" id="editCname" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all">
            </div>
            <div class="flex justify-end gap-3">
                <button type="button" onclick="document.getElementById('editModal').classList.add('hidden')" class="px-5 py-2.5 font-bold text-slate-500 hover:bg-slate-50 rounded-xl transition-colors">Cancel</button>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-xl font-bold shadow-md transition-colors">Update</button>
            </div>
        </form>
    </div>
</div>

 
<form id="deleteForm" action="/Admin/DeleteLocation" method="post" class="hidden">
    <input type="hidden" name="id" id="deleteId" />
    <input type="hidden" name="filterDid" value="@ViewBag.FilterDid" />
</form>

@section Scripts {
<script>
    lucide.createIcons();
    function openEditModal(cid, did, cname) {
        document.getElementById('editCid').value = cid;
        document.getElementById('editDid').value = did;
        document.getElementById('editCname').value = cname;
        document.getElementById('editModal').classList.remove('hidden');
    }
    function confirmDelete(id) {
        if(confirm('Are you sure you want to delete this location?')) {
            document.getElementById('deleteId').value = id;
            document.getElementById('deleteForm').submit();
        }
    }
</script>
}