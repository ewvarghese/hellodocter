@model IEnumerable<HelloDoctor.Care.Models.SubscriptionPlan>
@{ ViewData["Title"] = "Renew Subscription"; }
<main class="max-w-md mx-auto px-6 py-16 relative">
    <div class="bg-white border border-slate-200 rounded-[2.5rem] p-8 md:p-10 shadow-xl shadow-slate-200/40 relative z-10">
        <h2 class="text-2xl font-black text-slate-900 uppercase tracking-wide mb-2">Renew Your Subscription</h2>
        <p class="text-sm text-slate-500 font-semibold mb-8">Select a plan to continue accessing the portal.</p>
        
        <div class="space-y-5">
            <!-- Hidden Fields for Checkout -->
            <input type="hidden" id="name" value="@ViewBag.UserName" />
            <input type="hidden" id="email" value="@ViewBag.Email" />
            <input type="hidden" id="mobile" value="@ViewBag.Mobile" />
            <input type="hidden" id="address" value="@ViewBag.Address" />
            <input type="hidden" id="selectedPlanId" />

            <div>
                <select id="ddlPlans" class="w-full px-5 py-3.5 bg-white border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 outline-none focus:border-[#10b981] focus:ring-4 focus:ring-[#10b981]/10 transition-all shadow-sm hover:border-slate-300">
                    <option value="0">--Select Plan--</option>
                    @foreach (var plan in Model)
                    {
                        <option value="@plan.Pid">@plan.Pname</option>
                    }
                </select>
            </div>
            
            <div>
                <input type="text" id="txtamt" readonly placeholder="Amount" class="w-full px-5 py-3.5 bg-slate-100 border border-slate-200 rounded-xl text-sm font-black text-slate-500 outline-none cursor-not-allowed shadow-inner">
            </div>

            <button id="rzp-button1" class="w-full bg-[#10b981] text-white px-5 py-3.5 rounded-xl font-bold uppercase tracking-widest shadow-lg shadow-emerald-500/20 hover:bg-emerald-600 transition-colors mt-4 flex items-center justify-center gap-2">
                Pay Now
            </button>
        </div>
    </div>

    <!-- Hidden form that submits successful Razorpay data -->
    <form id="razorpayForm" action="/Renewal/PaymentSuccess" method="post" class="hidden">
        <input type="hidden" id="razorpay_payment_id" name="razorpay_payment_id" />
        <input type="hidden" id="razorpay_order_id" name="razorpay_order_id" />
        <input type="hidden" id="razorpay_signature" name="razorpay_signature" />
        <input type="hidden" id="hiddenPlanId" name="planId" />
        <input type="hidden" id="hiddenAmountPaid" name="amountPaid" />
    </form>
</main>

@section Scripts {
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
    document.getElementById('ddlPlans').addEventListener('change', async function() {
        var pid = this.value;
        document.getElementById('selectedPlanId').value = pid;
        if(pid == "0") {
            document.getElementById('txtamt').value = "";
            return;
        }

        try {
            const res = await fetch(`/Renewal/GetPlanDetails?pid=${pid}`);
            const data = await res.json();
            document.getElementById('txtamt').value = data.amount;
        } catch (err) {
            console.error(err);
        }
    });

    document.getElementById('rzp-button1').onclick = async function (e) {
        e.preventDefault();
        
        var amount = document.getElementById('txtamt').value;
        var pid = document.getElementById('selectedPlanId').value;
        
        if(!amount || amount == "0" || !pid || pid == "0") {
            showToast("Please select a valid plan.", "error");
            return;
        }

        var Name = document.getElementById('name').value;
        var email = document.getElementById('email').value;
        var contact = document.getElementById('mobile').value;
        var address = document.getElementById('address').value;

        try {
            const response = await fetch("/Renewal/GenerateOrder", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ amount: amount })
            });

            const data = await response.json();
            var orderId = data.orderId;
            var amountInPaise = data.amount;

            if (!orderId || !amountInPaise) {
                showToast("Order generation failed. Please try again.", "error");
                return;
            }

          
            var options = {
                    "key": " ",
                "amount": amountInPaise,
                "currency": "INR",
                "name": Name,
                "description": Name + " - Subscription Renewal",
                "image": "/images/logo.png",
                "order_id": orderId,
                "prefill": {
                    "name": Name,
                    "email": email,
                    "contact": contact,
                },
                "notes": {
                    "address": address,
                    "merchant_order_id": orderId,
                },
                "theme": {
                    "color": "#F37254"
                },
                "handler": function (response) {
                    document.getElementById('razorpay_payment_id').value = response.razorpay_payment_id;
                    document.getElementById('razorpay_order_id').value = orderId;
                    document.getElementById('razorpay_signature').value = response.razorpay_signature;
                    
                    document.getElementById('hiddenPlanId').value = pid;
                    document.getElementById('hiddenAmountPaid').value = amount;
                    
                    document.getElementById('razorpayForm').submit();
                },
                "modal": {
                    "ondismiss": function () { console.log("Razorpay popup closed"); },
                    "escape": true,
                    "backdropclose": false
                }
            };

            var rzp = new Razorpay(options);
            rzp.open();
            
        } catch (err) {
            console.error(err);
            showToast("Order generation failed.", "error");
        }
    };
</script>
}
