@model HelloDoctor.Care.Models.PatientReport
@{
    ViewData["Title"] = "Edit Patient Report";
    string visitDateIso = ViewBag.VisitDateIso as string ?? "";
}

<div class="w-full flex-grow flex flex-col py-6 px-2">
    <div class="max-w-4xl mx-auto w-full space-y-8 animate-in fade-in duration-500">

        <div class="flex items-center justify-between">
            <h3 class="text-2xl font-black text-slate-800 flex items-center gap-3">
                <i data-lucide="pencil" class="text-[#f26522]"></i> Edit Report <span class="text-slate-400">#@Model.Rptid</span>
            </h3>
            <a href="/Report/Details/@Model.Rptid" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-5 py-3 rounded-xl font-bold transition-colors flex items-center gap-2">
                <i data-lucide="arrow-left" class="w-5 h-5"></i> Back
            </a>
        </div>

        <form action="/Report/Edit" method="post" class="space-y-6">
            <input type="hidden" name="id" value="@Model.Rptid" />

            <div class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm space-y-6">
                <p class="text-xs font-black text-slate-400 uppercase tracking-widest">
                    Patient & Visit &nbsp;·&nbsp; Doctor: <span class="text-slate-600">@(Model.Doctor?.Drname ?? "-")</span>
                </p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label class="text-xs font-black text-slate-500 uppercase tracking-widest">Patient Name *</label>
                        <input type="text" name="Pname" required value="@Model.Pname"
                               class="w-full mt-2 px-5 py-3.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 outline-none focus:border-[#f26522] focus:ring-4 focus:ring-[#f26522]/10 transition-all">
                    </div>
                    <div>
                        <label class="text-xs font-black text-slate-500 uppercase tracking-widest">Mobile</label>
                        <input type="text" name="Mobnum" value="@Model.Mobnum"
                               class="w-full mt-2 px-5 py-3.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 outline-none focus:border-[#f26522] focus:ring-4 focus:ring-[#f26522]/10 transition-all">
                    </div>
                    <div>
                        <label class="text-xs font-black text-slate-500 uppercase tracking-widest">Age</label>
                        <input type="text" name="Age" value="@Model.Age"
                               class="w-full mt-2 px-5 py-3.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 outline-none focus:border-[#f26522] focus:ring-4 focus:ring-[#f26522]/10 transition-all">
                    </div>
                    <div>
                        <label class="text-xs font-black text-slate-500 uppercase tracking-widest">Visit Date</label>
                        <input type="date" name="Visitdate" value="@visitDateIso"
                               class="w-full mt-2 px-5 py-3.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 outline-none focus:border-[#f26522] focus:ring-4 focus:ring-[#f26522]/10 transition-all">
                    </div>
                    <div class="md:col-span-2">
                        <label class="text-xs font-black text-slate-500 uppercase tracking-widest">Address</label>
                        <input type="text" name="Addr" value="@Model.Addr"
                               class="w-full mt-2 px-5 py-3.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 outline-none focus:border-[#f26522] focus:ring-4 focus:ring-[#f26522]/10 transition-all">
                    </div>
                </div>
            </div>

            <div class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm space-y-6">
                <p class="text-xs font-black text-slate-400 uppercase tracking-widest">Medical Report</p>

                <div>
                    <label class="text-xs font-black text-slate-500 uppercase tracking-widest">Diagnosis</label>
                    <textarea name="Diagnosis" rows="3"
                              class="w-full mt-2 px-5 py-3.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 outline-none focus:border-[#f26522] focus:ring-4 focus:ring-[#f26522]/10 transition-all resize-y">@Model.Diagnosis</textarea>
                </div>
                <div>
                    <label class="text-xs font-black text-slate-500 uppercase tracking-widest">Prescription</label>
                    <textarea name="Prescription" rows="3"
                              class="w-full mt-2 px-5 py-3.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 outline-none focus:border-[#f26522] focus:ring-4 focus:ring-[#f26522]/10 transition-all resize-y">@Model.Prescription</textarea>
                </div>
                <div>
                    <label class="text-xs font-black text-slate-500 uppercase tracking-widest">Advice / Notes</label>
                    <textarea name="Advice" rows="3"
                              class="w-full mt-2 px-5 py-3.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 outline-none focus:border-[#f26522] focus:ring-4 focus:ring-[#f26522]/10 transition-all resize-y">@Model.Advice</textarea>
                </div>
            </div>

            <div class="flex items-center gap-4">
                <button type="submit" class="bg-[#10b981] hover:bg-emerald-600 text-white px-8 py-3.5 rounded-xl font-black uppercase tracking-widest shadow-lg transition-colors flex items-center gap-2">
                    <i data-lucide="save" class="w-5 h-5"></i> Save Changes
                </button>
                <a href="/Report/Details/@Model.Rptid" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-8 py-3.5 rounded-xl font-bold transition-colors">
                    Cancel
                </a>
            </div>
        </form>

    </div>
</div>
