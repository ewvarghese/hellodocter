@model HelloDoctor.Care.Models.PatientReport
@{
    ViewData["Title"] = "Patient Report Details";
}

<div class="w-full flex-grow flex flex-col py-6 px-2">
    <div class="max-w-4xl mx-auto w-full space-y-8 animate-in fade-in duration-500">

        <div class="flex items-center justify-between flex-wrap gap-4">
            <h3 class="text-2xl font-black text-slate-800 flex items-center gap-3">
                <i data-lucide="file-text" class="text-[#f26522]"></i> Patient Report <span class="text-slate-400">#@Model.Rptid</span>
            </h3>
            <div class="flex items-center gap-3">
                <a href="/Report/PrintReport/@Model.Rptid" target="_blank" class="bg-[#10b981] hover:bg-emerald-600 text-white px-5 py-3 rounded-xl font-bold shadow-md transition-colors flex items-center gap-2">
                    <i data-lucide="printer" class="w-5 h-5"></i> Print
                </a>
                <a href="/Report/Edit/@Model.Rptid" class="bg-sky-50 text-sky-600 hover:bg-sky-600 hover:text-white px-5 py-3 rounded-xl font-bold transition-colors flex items-center gap-2">
                    <i data-lucide="pencil" class="w-5 h-5"></i> Edit
                </a>
                <a href="/Report/MedicalReports" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-5 py-3 rounded-xl font-bold transition-colors flex items-center gap-2">
                    <i data-lucide="arrow-left" class="w-5 h-5"></i> Back
                </a>
            </div>
        </div>

        @if (TempData["SuccessMsg"] != null) {
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-600 px-6 py-4 rounded-xl font-bold flex items-center gap-3">
                <i data-lucide="check-circle" class="w-5 h-5"></i> @TempData["SuccessMsg"]
            </div>
        }
        @if (TempData["ErrorMsg"] != null) {
            <div class="bg-red-50 border border-red-200 text-red-600 px-6 py-4 rounded-xl font-bold flex items-center gap-3">
                <i data-lucide="alert-circle" class="w-5 h-5"></i> @TempData["ErrorMsg"]
            </div>
        }

        <!-- Patient & doctor -->
        <div class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 text-sm">
                <div>
                    <p class="text-xs font-black text-slate-400 uppercase tracking-widest">Patient</p>
                    <p class="font-black text-slate-800 text-base mt-1">@Model.Pname</p>
                </div>
                <div>
                    <p class="text-xs font-black text-slate-400 uppercase tracking-widest">Mobile</p>
                    <p class="font-semibold text-slate-700 mt-1">@(Model.Mobnum ?? "-")</p>
                </div>
                <div>
                    <p class="text-xs font-black text-slate-400 uppercase tracking-widest">Age</p>
                    <p class="font-semibold text-slate-700 mt-1">@(Model.Age ?? "-")</p>
                </div>
                <div>
                    <p class="text-xs font-black text-slate-400 uppercase tracking-widest">Doctor</p>
                    <p class="font-semibold text-slate-700 mt-1">@(Model.Doctor?.Drname ?? "-")</p>
                </div>
                <div>
                    <p class="text-xs font-black text-slate-400 uppercase tracking-widest">Department</p>
                    <p class="font-semibold text-slate-700 mt-1">@(Model.Doctor?.Department?.Depname ?? "-")</p>
                </div>
                <div>
                    <p class="text-xs font-black text-slate-400 uppercase tracking-widest">Visit Date</p>
                    <p class="font-semibold text-slate-700 mt-1">@(Model.Visitdate ?? "-")</p>
                </div>
                <div class="sm:col-span-2 lg:col-span-3">
                    <p class="text-xs font-black text-slate-400 uppercase tracking-widest">Address</p>
                    <p class="font-semibold text-slate-700 mt-1">@(Model.Addr ?? "-")</p>
                </div>
            </div>
        </div>

        <!-- Medical report -->
        <div class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm space-y-6">
            <p class="text-xs font-black text-slate-400 uppercase tracking-widest">Medical Report</p>
            <div>
                <p class="text-xs font-black text-emerald-600 uppercase tracking-widest">Diagnosis</p>
                <p class="mt-2 text-slate-700 font-semibold whitespace-pre-wrap">@(string.IsNullOrWhiteSpace(Model.Diagnosis) ? "-" : Model.Diagnosis)</p>
            </div>
            <div>
                <p class="text-xs font-black text-sky-600 uppercase tracking-widest">Prescription</p>
                <p class="mt-2 text-slate-700 font-semibold whitespace-pre-wrap">@(string.IsNullOrWhiteSpace(Model.Prescription) ? "-" : Model.Prescription)</p>
            </div>
            <div>
                <p class="text-xs font-black text-orange-600 uppercase tracking-widest">Advice / Notes</p>
                <p class="mt-2 text-slate-700 font-semibold whitespace-pre-wrap">@(string.IsNullOrWhiteSpace(Model.Advice) ? "-" : Model.Advice)</p>
            </div>
            <p class="text-xs text-slate-400 font-semibold">Created: @Model.Createddate &nbsp;|&nbsp; Last updated: @Model.Updte</p>
        </div>

        <!-- Files -->
        <div class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm space-y-6">
            <div class="flex items-center justify-between">
                <p class="text-xs font-black text-slate-400 uppercase tracking-widest">Report Files (@Model.Files.Count)</p>
            </div>

            @if (Model.Files.Count > 0) {
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    @foreach (var file in Model.Files) {
                        bool isImage = file.ContentType != null && file.ContentType.StartsWith("image/");
                        <div class="border border-slate-200 rounded-2xl overflow-hidden">
                            @if (isImage) {
                                <a href="~/uploads/reports/@file.StoredName" target="_blank" class="block h-40 bg-slate-100 overflow-hidden">
                                    <img src="~/uploads/reports/@file.StoredName" alt="@file.FileName" class="w-full h-full object-cover">
                                </a>
                            } else {
                                <a href="~/uploads/reports/@file.StoredName" target="_blank" class="flex items-center justify-center h-40 bg-slate-50">
                                    <i data-lucide="file-text" class="w-12 h-12 text-slate-400"></i>
                                </a>
                            }
                            <div class="p-4 space-y-3">
                                <p class="text-sm font-bold text-slate-700 truncate" title="@file.FileName">@file.FileName</p>
                                <p class="text-xs text-slate-400 font-semibold">
                                    @(file.FileSize.HasValue ? (file.FileSize.Value / 1024).ToString() + " KB" : "") &nbsp;·&nbsp; @file.UploadedDate
                                </p>
                                <div class="flex items-center gap-2">
                                    <a href="~/uploads/reports/@file.StoredName" target="_blank" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-2 rounded-xl text-xs font-black uppercase tracking-wider text-center transition-colors">
                                        View
                                    </a>
                                    <form action="/Report/DeleteFile" method="post" onsubmit="return confirm('Delete this file?');">
                                        <input type="hidden" name="fileId" value="@file.Fileid" />
                                        <input type="hidden" name="returnId" value="@Model.Rptid" />
                                        <button type="submit" class="bg-red-50 text-red-500 hover:bg-red-500 hover:text-white px-3 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-colors">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            } else {
                <p class="text-sm text-slate-400 font-semibold">No files uploaded yet.</p>
            }

            <!-- Upload more files -->
            <form action="/Report/UploadFiles" method="post" enctype="multipart/form-data" class="border-t border-slate-100 pt-6 space-y-4">
                <input type="hidden" name="id" value="@Model.Rptid" />
                <p class="text-xs font-black text-slate-400 uppercase tracking-widest">Add More Files</p>
                <input type="file" name="Files" multiple accept=".pdf,.jpg,.jpeg,.png,.gif,.webp"
                       class="w-full text-sm text-slate-600 font-semibold file:mr-4 file:px-5 file:py-3 file:rounded-xl file:border-0 file:bg-[#f26522]/10 file:text-[#f26522] file:font-black file:uppercase file:tracking-wider hover:file:bg-[#f26522]/20 transition-colors">
                <button type="submit" class="bg-[#f26522] hover:bg-orange-600 text-white px-6 py-3 rounded-xl font-bold shadow-md transition-colors flex items-center gap-2">
                    <i data-lucide="upload" class="w-5 h-5"></i> Upload
                </button>
            </form>
        </div>

        <!-- Delete report -->
        <div class="flex justify-end">
            <form action="/Report/Delete" method="post" onsubmit="return confirm('Delete this whole report (including its files)? This cannot be undone.');">
                <input type="hidden" name="id" value="@Model.Rptid" />
                <button type="submit" class="bg-red-50 text-red-500 hover:bg-red-500 hover:text-white px-6 py-3 rounded-xl font-bold transition-colors flex items-center gap-2">
                    <i data-lucide="trash-2" class="w-5 h-5"></i> Delete Report
                </button>
            </form>
        </div>

    </div>
</div>
