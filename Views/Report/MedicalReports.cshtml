@{
    ViewData["Title"] = "Medical Reports";
    var reports = ViewBag.Reports as IEnumerable<HelloDoctor.Care.Models.PatientReport>
                  ?? Enumerable.Empty<HelloDoctor.Care.Models.PatientReport>();
}

<div class="w-full flex-grow flex flex-col py-6 px-2">
    <div class="max-w-7xl mx-auto w-full space-y-8 animate-in fade-in duration-500">

        <div class="flex items-center justify-between flex-wrap gap-4">
            <h3 class="text-2xl font-black text-slate-800 flex items-center gap-3">
                <i data-lucide="clipboard-list" class="text-[#f26522]"></i> Medical Reports
            </h3>
            <div class="flex items-center gap-3">
                <a href="/Report/Index" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-5 py-3 rounded-xl font-bold transition-colors flex items-center gap-2">
                    <i data-lucide="users" class="w-5 h-5"></i> Patient Report
                </a>
                <a href="/Report/Add" class="bg-[#f26522] hover:bg-orange-600 text-white px-5 py-3 rounded-xl font-bold shadow-md transition-colors flex items-center gap-2">
                    <i data-lucide="file-plus" class="w-5 h-5"></i> New Report
                </a>
            </div>
        </div>

        @if (TempData["SuccessMsg"] != null) {
            <div class="bg-emerald-50 border border-emerald-200 text-emerald-600 px-6 py-4 rounded-xl font-bold flex items-center gap-3">
                <i data-lucide="check-circle" class="w-5 h-5"></i> @TempData["SuccessMsg"]
            </div>
        }

        <!-- Filters -->
        <div class="bg-white border border-slate-200 rounded-[2rem] p-6 md:p-8 shadow-sm">
            <form action="/Report/MedicalReports" method="get" class="flex flex-wrap items-end gap-4">
                @if (!(ViewBag.IsDoctorUser ?? false)) {
                    <div class="flex flex-col gap-2">
                        <label class="text-xs font-black text-slate-400 uppercase tracking-widest">Doctor</label>
                        <select name="doctorId" class="px-5 py-3.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 outline-none focus:border-[#f26522] focus:ring-4 focus:ring-[#f26522]/10 transition-all min-w-56">
                            <option value="0">All Doctors</option>
                            @foreach (var doc in ViewBag.Doctors) {
                                if (ViewBag.DoctorId == doc.Drid) {
                                    <option value="@doc.Drid" selected>@doc.Drname</option>
                                } else {
                                    <option value="@doc.Drid">@doc.Drname</option>
                                }
                            }
                        </select>
                    </div>
                }
                <div class="flex flex-col gap-2">
                    <label class="text-xs font-black text-slate-400 uppercase tracking-widest">Search</label>
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="Patient name or mobile..."
                           class="px-5 py-3.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 outline-none focus:border-[#f26522] focus:ring-4 focus:ring-[#f26522]/10 transition-all min-w-64">
                </div>
                <button type="submit" class="bg-[#f26522] hover:bg-orange-600 text-white px-6 py-3.5 rounded-xl font-bold shadow-md transition-colors flex items-center gap-2">
                    <i data-lucide="search" class="w-5 h-5"></i> Search
                </button>
                <a href="/Report/MedicalReports" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-6 py-3.5 rounded-xl font-bold transition-colors">
                    Clear
                </a>
            </form>
        </div>

        <!-- Reports table -->
        <div class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse whitespace-nowrap">
                    <thead>
                        <tr class="border-b border-slate-200">
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest w-16">Sl</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Patient</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Mobile</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Doctor</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Visit Date</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Diagnosis</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Files</th>
                            <th class="py-4 px-4 text-xs font-black text-slate-400 uppercase tracking-widest">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm font-semibold text-slate-700">
                        @if (!reports.Any()) {
                            <tr>
                                <td colspan="8" class="py-12 text-center text-slate-400 font-semibold">
                                    No medical reports found. Click <strong>New Report</strong> to create one.
                                </td>
                            </tr>
                        } else {
                            int index = 1;
                            foreach (var rpt in reports) {
                                <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition-colors">
                                    <td class="py-4 px-4 text-slate-400">@index</td>
                                    <td class="py-4 px-4 font-black">@rpt.Pname</td>
                                    <td class="py-4 px-4">@(rpt.Mobnum ?? "-")</td>
                                    <td class="py-4 px-4">@(rpt.Doctor?.Drname ?? "-")</td>
                                    <td class="py-4 px-4">@(rpt.Visitdate ?? "-")</td>
                                    <td class="py-4 px-4 max-w-xs truncate" title="@rpt.Diagnosis">
                                        @(string.IsNullOrWhiteSpace(rpt.Diagnosis) ? "-" : rpt.Diagnosis)
                                    </td>
                                    <td class="py-4 px-4">
                                        <span class="inline-flex items-center gap-1.5 bg-slate-100 text-slate-600 px-3 py-1 rounded-full text-xs font-black">
                                            <i data-lucide="paperclip" class="w-3.5 h-3.5"></i> @rpt.Files.Count
                                        </span>
                                    </td>
                                    <td class="py-4 px-4">
                                        <div class="flex items-center gap-2">
                                            <a href="/Report/Details/@rpt.Rptid" class="bg-sky-50 text-sky-600 hover:bg-sky-600 hover:text-white px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-colors flex items-center gap-1.5">
                                                <i data-lucide="eye" class="w-4 h-4"></i> View
                                            </a>
                                            <a href="/Report/Edit/@rpt.Rptid" class="bg-slate-100 text-slate-600 hover:bg-slate-600 hover:text-white px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-colors flex items-center gap-1.5">
                                                <i data-lucide="pencil" class="w-4 h-4"></i> Edit
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>
