@{
    ViewData["Title"] = "Available Doctors";
}

<style>
    /* Decorative Background */
    .ambient-bg {
        position: fixed;
        inset: 0;
        z-index: -10;
        background-color: #ffffff;
        background-image: radial-gradient(at 100% 0%, hsla(23, 89%, 54%, 0.08) 0px, transparent 50%), radial-gradient(at 0% 100%, hsla(215, 100%, 60%, 0.05) 0px, transparent 50%);
    }

    .card-hover {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
        }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
        width: 8px;
    }

    ::-webkit-scrollbar-track {
        background: #f8fafc;
    }

    ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
</style>

<div class="ambient-bg"></div>

<main class="max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-10 relative z-10">
    <!-- Results Info -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 md:mb-10 animate-in slide-in-from-top-4 duration-500">
        <div>
            <nav class="flex items-center gap-2 text-xs font-black text-slate-400 uppercase tracking-widest mb-3">
                <a href="/" class="hover:text-[#f26522] transition-colors">Home</a>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                <span class="text-slate-600">Search Results</span>
            </nav>
            <h1 class="text-3xl md:text-4xl font-black text-slate-900 tracking-tight">
                Doctors in <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#f26522] to-orange-400">@ViewBag.LocationName</span>
            </h1>
            <p class="text-slate-500 font-medium mt-2 flex items-center gap-2" id="resultsCount">
                <i data-lucide="loader-2" class="w-4 h-4 animate-spin text-[#f26522]"></i>
                Searching for @(ViewBag.DeptName ?? "Specialists")...
            </p>
        </div>

        <div class="self-start md:self-auto">
            <!-- Relocated Back Button to Live Queue -->
            <button onclick="window.location.href='/Home/LiveQueue' + window.location.search;" class="inline-flex items-center gap-2 px-5 py-3 bg-white/80 backdrop-blur-md border border-slate-200/60 rounded-xl shadow-sm hover:bg-orange-50 hover:text-[#f26522] hover:border-orange-200 text-slate-600 font-bold transition-all" title="Go back to Live Queue">
                <i data-lucide="arrow-left" class="w-5 h-5"></i> Back to Live Queue
            </button>
        </div>
    </div>

    <div class="grid lg:grid-cols-4 gap-8">
        <!-- Filters Sidebar -->
        <aside class="hidden lg:block space-y-8 animate-in slide-in-from-left-8 duration-700">
            <div class="bg-white/80 backdrop-blur-xl border border-slate-200/60 rounded-[2rem] p-6 shadow-[0_8px_30px_rgb(0,0,0,0.04)]">
                <h3 class="text-xs font-black text-slate-900 uppercase tracking-widest mb-6 flex items-center gap-2">
                    <i data-lucide="filter" class="w-4 h-4 text-[#f26522]"></i> Filter By Fee
                </h3>
                <div class="space-y-4">
                    <label class="flex items-center gap-4 cursor-pointer group p-2 rounded-xl hover:bg-orange-50/50 transition-colors">
                        <div class="relative flex items-center justify-center">
                            <input type="checkbox" id="feeUnder300" onchange="renderFilteredDoctors()" class="peer appearance-none w-5 h-5 rounded-md border-2 border-slate-300 checked:bg-[#f26522] checked:border-[#f26522] transition-all outline-none focus:ring-4 focus:ring-[#f26522]/20 cursor-pointer" />
                            <i data-lucide="check" class="w-3.5 h-3.5 text-white absolute opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity"></i>
                        </div>
                        <span class="text-sm font-bold text-slate-600 group-hover:text-slate-900 transition-colors">Under ₹300</span>
                    </label>

                    <label class="flex items-center gap-4 cursor-pointer group p-2 rounded-xl hover:bg-orange-50/50 transition-colors">
                        <div class="relative flex items-center justify-center">
                            <input type="checkbox" id="fee300to600" onchange="renderFilteredDoctors()" class="peer appearance-none w-5 h-5 rounded-md border-2 border-slate-300 checked:bg-[#f26522] checked:border-[#f26522] transition-all outline-none focus:ring-4 focus:ring-[#f26522]/20 cursor-pointer" />
                            <i data-lucide="check" class="w-3.5 h-3.5 text-white absolute opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity"></i>
                        </div>
                        <span class="text-sm font-bold text-slate-600 group-hover:text-slate-900 transition-colors">₹300 - ₹600</span>
                    </label>
                </div>
            </div>
        </aside>

        <!-- Listing -->
        <div class="lg:col-span-3 space-y-4 md:space-y-6" id="doctorList">
            <!-- Dynamic Doctor Cards will be populated here by JavaScript -->
            <div class="animate-pulse space-y-4 md:space-y-6">
                <div class="bg-white/60 border border-slate-100 rounded-3xl p-4 md:p-6 h-40 md:h-48"></div>
                <div class="bg-white/60 border border-slate-100 rounded-3xl p-4 md:p-6 h-40 md:h-48"></div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const did = urlParams.get('did');
        const cid = urlParams.get('cid');
        const depid = urlParams.get('depid');

 
        let allDoctors = [];

        async function load() {
            try {
                const res = await fetch(`/Home/GetDoctors?did=${did}&cid=${cid}&depid=${depid}`);
                allDoctors = await res.json();
                renderFilteredDoctors();  
            } catch (error) {
                console.error("Error loading doctors:", error);
                document.getElementById('doctorList').innerHTML = `
                                <div class="bg-white border border-red-100 rounded-[2rem] p-8 md:p-10 text-center shadow-sm">
                                    <div class="w-16 h-16 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-4">
                                        <i data-lucide="alert-triangle" class="w-8 h-8 text-red-500"></i>
                                    </div>
                                    <h3 class="text-lg font-bold text-slate-900 mb-2">Failed to load doctors</h3>
                                    <p class="text-sm text-slate-500">Please check your connection and try again.</p>
                                </div>`;
                lucide.createIcons();
            }
        }

        function renderFilteredDoctors() {
            const list = document.getElementById('doctorList');
            const resultsCount = document.getElementById('resultsCount');

       
            const isUnder300 = document.getElementById('feeUnder300').checked;
            const is300to600 = document.getElementById('fee300to600').checked;

            
            let filteredData = allDoctors;
            if (isUnder300 || is300to600) {
                filteredData = allDoctors.filter(doc => {
                    const fee = parseFloat(doc.cfee) || 300;
                    if (isUnder300 && fee < 300) return true;
                    if (is300to600 && fee >= 300 && fee <= 600) return true;
                    return false;
                });
            }

        
            resultsCount.innerHTML = `Found <span class="font-black text-[#f26522] mx-1">${filteredData.length}</span> Specialists for <span class="font-bold text-slate-700 ml-1">@ViewBag.DeptName</span>`;

            if (filteredData.length === 0) {
                list.innerHTML = `
                                <div class="bg-white/80 backdrop-blur-xl border border-slate-200/60 rounded-[2rem] p-8 md:p-12 text-center shadow-sm animate-in fade-in duration-500">
                                    <div class="w-20 h-20 md:w-24 md:h-24 bg-orange-50 rounded-[1.5rem] md:rounded-[2rem] flex items-center justify-center mx-auto mb-6 transform rotate-3 border border-orange-100">
                                        <i data-lucide="stethoscope" class="w-10 h-10 md:w-12 md:h-12 text-[#f26522] opacity-80"></i>
                                    </div>
                                    <h3 class="text-xl md:text-2xl font-black text-slate-900 mb-2 md:mb-3">No doctors found</h3>
                                    <p class="text-sm md:text-base text-slate-500 font-medium">Try adjusting your fee filters or searching a different area.</p>
                                    <button onclick="window.location.href='/'" class="mt-6 md:mt-8 px-6 py-3 font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors text-sm md:text-base">
                                        Go Back Home
                                    </button>
                                </div>`;
                lucide.createIcons();
                return;
            }

            list.innerHTML = '';

            filteredData.forEach((doc, index) => {
              
                let liveQueueHTML = '';
                if (doc.liveToken && doc.liveToken > 0) {
                    liveQueueHTML = `
                                <div class="bg-orange-50 border border-orange-100 p-2.5 sm:p-3 md:p-4 rounded-xl md:rounded-[1.25rem] flex items-center justify-between shadow-inner">
                                    <div class="flex flex-col">
                                        <span class="text-[9px] md:text-[10px] font-black text-[#f26522] uppercase tracking-widest mb-0.5">Live Queue</span>
                                        <span class="text-xs md:text-sm font-black text-slate-900">Serving #${doc.liveToken}</span>
                                    </div>
                                    <div class="w-6 h-6 md:w-8 md:h-8 rounded-full bg-orange-100 flex items-center justify-center shadow-sm animate-pulse shrink-0">
                                        <div class="w-2 h-2 md:w-3 md:h-3 bg-[#f26522] rounded-full"></div>
                                    </div>
                                </div>`;
                }

          
                const animDelay = index * 100;

                list.innerHTML += `
                            <div class="bg-white/90 backdrop-blur-xl border border-white/40 rounded-3xl md:rounded-[2rem] p-4 sm:p-6 md:p-8 card-hover relative overflow-hidden shadow-[0_8px_30px_rgb(0,0,0,0.06)] animate-in slide-in-from-bottom-8 duration-700" style="animation-delay: ${animDelay}ms; animation-fill-mode: both;">
                                <div class="flex flex-col sm:flex-row gap-4 md:gap-6 lg:gap-8">

                                    <!-- MOBILE VIEW (Hidden on screens sm and larger) -->
                                    <div class="flex flex-col sm:hidden gap-3">
                                        <!-- Mobile Row 1: Image & Core Info -->
                                        <div class="flex items-center gap-3 sm:gap-4">
                                            <div class="w-20 h-20 bg-slate-50 rounded-[1.25rem] overflow-hidden border-[2px] border-white shadow-md shrink-0">
                                                <img src="${doc.photo ? '/images/' + doc.photo : 'https://ui-avatars.com/api/?name=Dr&background=fff7ed&color=f26522&size=400'}" alt="Doctor" class="w-full h-full object-cover" />
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <h2 class="text-lg font-black text-slate-900 tracking-tight truncate">  ${doc.name}</h2>
                                                <p class="text-xs font-bold text-[#f26522] mt-0.5 mb-1.5 truncate">${doc.designation || 'Specialist'}</p>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-slate-100 text-slate-600 rounded text-[10px] font-bold uppercase tracking-widest truncate max-w-full">
                                                    ${doc.deptName}
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Mobile Row 2: Location & Fee Box -->
                                        <div class="flex items-center justify-between bg-slate-50 p-2.5 rounded-xl border border-slate-100">
                                            <div class="flex items-center gap-1.5 min-w-0 flex-1 pr-2">
                                                <i data-lucide="map-pin" class="w-3.5 h-3.5 text-[#f26522] shrink-0"></i>
                                                <span class="text-xs font-bold text-slate-600 truncate">${doc.addr || doc.Addr || doc.address || doc.Address || '@ViewBag.LocationName'}</span>
                                            </div>
                                            <div class="text-right shrink-0 border-l border-slate-200 pl-3">
                                                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Fee</p>
                                                <p class="text-sm font-black text-slate-900">₹${doc.cfee || 300}</p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- DESKTOP/TABLET Profile Image (Hidden on mobile) -->
                                    <div class="relative shrink-0 hidden sm:block">
                                        <div class="w-28 h-28 md:w-36 md:h-36 bg-slate-50 rounded-[1.5rem] overflow-hidden border-[3px] border-white shadow-lg">
                                            <img src="${doc.photo ? '/images/' + doc.photo : 'https://ui-avatars.com/api/?name=Dr&background=fff7ed&color=f26522&size=400'}" alt="Doctor" class="w-full h-full object-cover" />
                                        </div>
                                    </div>

                                    <!-- DESKTOP/TABLET Details (Hidden on mobile) -->
                                    <div class="hidden sm:flex flex-1 flex-col text-left">
                                        <div class="flex flex-row items-start justify-between gap-4 mb-4">
                                            <div class="min-w-0">
                                                <h2 class="text-xl md:text-2xl font-black text-slate-900 tracking-tight truncate">  ${doc.name}</h2>
                                                <p class="text-sm font-bold text-[#f26522] mt-1 mb-2 truncate">${doc.designation || 'Specialist'}</p>
                                                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-slate-100 text-slate-600 rounded-lg text-xs font-bold uppercase tracking-widest">
                                                    <i data-lucide="tag" class="w-3 h-3"></i> ${doc.deptName}
                                                </span>
                                            </div>
                                            <div class="text-right bg-slate-50/80 p-3 md:p-4 rounded-xl md:rounded-2xl border border-slate-100 shrink-0">
                                                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Consultation Fee</p>
                                                <p class="text-xl md:text-2xl font-black text-slate-900">₹${doc.cfee || 300}</p>
                                            </div>
                                        </div>

                                        <div class="flex items-center gap-2.5 bg-slate-50 w-fit px-4 py-2 rounded-xl border border-slate-200/60 shadow-sm mt-auto">
                                            <i data-lucide="map-pin" class="w-4 h-4 text-[#f26522] shrink-0"></i>
                                            <span class="text-sm font-bold text-slate-600">${doc.addr || doc.Addr || doc.address || doc.Address || '@ViewBag.LocationName'}</span>
                                        </div>
                                    </div>

                                    <!-- SHARED Action/Live Status -->
                                    <div class="sm:w-48 lg:w-56 flex flex-col justify-center gap-3 sm:gap-4 sm:border-l border-slate-100 sm:pl-4 lg:pl-6 shrink-0 mt-1 sm:mt-0">
                                        ${liveQueueHTML}

                                        <button onclick="window.location.href='/Home/Schedule?drid=${doc.id}'" class="w-full bg-gradient-to-r from-[#f26522] to-[#e05615] hover:from-[#d95318] hover:to-[#c64810] text-white px-4 py-3 sm:py-3.5 rounded-xl font-bold shadow-[0_8px_20px_-4px_rgba(242,101,34,0.4)] hover:shadow-[0_12px_25px_-4px_rgba(242,101,34,0.5)] transform hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 text-sm border border-orange-500/20">
                                            Book <span class="hidden sm:inline">Appointment</span> <i data-lucide="arrow-right" class="w-4 h-4"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>`;
            });

          
            lucide.createIcons();
        }

        
        load();
    </script>
}