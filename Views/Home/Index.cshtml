@model IEnumerable<HelloDoctor.Care.Models.District>
@{
    ViewData["Title"] = "Home";
}

<style>
    /* Decorative Background */
    .ambient-bg {
        position: fixed;
        inset: 0;
        z-index: -10;
        background-color: #ffffff;
        background-image: radial-gradient(at 100% 0%, hsla(23, 89%, 54%, 0.08) 0px, transparent 50%), radial-gradient(at 0% 100%, hsla(215, 100%, 60%, 0.05) 0px, transparent 50%);
    }

    .grid-pattern {
        position: fixed;
        inset: 0;
        z-index: -10;
        background-size: 40px 40px;
        background-image: linear-gradient(to right, rgba(0, 0, 0, 0.02) 1px, transparent 1px), linear-gradient(to bottom, rgba(0, 0, 0, 0.02) 1px, transparent 1px);
        mask-image: linear-gradient(to bottom, transparent, black, transparent);
        -webkit-mask-image: linear-gradient(to bottom, transparent, black, transparent);
    }

    /* Tab Styles */
    .tab-active {
        background-color: white;
        color: #f26522; /* Brand Orange */
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        transform: scale(1.02);
    }

    .tab-inactive {
        color: #64748b; /* Slate 500 */
        background-color: transparent;
    }

        .tab-inactive:hover {
            color: #334155; /* Slate 700 */
            background-color: rgba(255, 255, 255, 0.5);
        }
</style>

<!-- Backgrounds -->
<div class="ambient-bg"></div>
<div class="grid-pattern"></div>

<main class="max-w-3xl mx-auto px-6 py-12 md:py-20 relative z-10">

    <!-- Brand Logo & Hero Header -->
    <div class="text-center mb-12 animate-in slide-in-from-top-8 duration-700">
       @*  <img src="~/images/logo_hover (1).png" alt="HelloDoctor.Care" class="h-16 md:h-20 mx-auto drop-shadow-md mb-8" onerror="this.src='/images/logo.png'; this.onerror=null;" />
 *@
        <h1 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight mb-4">
            Find your <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#f26522] to-orange-400">Doctor</span> instantly.
        </h1>
        <p class="text-slate-500 text-lg max-w-lg mx-auto font-medium leading-relaxed">
            Book verified appointments or track live queue status across top clinics and hospitals in your area.
        </p>
    </div>

    <!-- Toggle Tabs -->
    <div class="max-w-md mx-auto mb-10 p-1.5 bg-slate-200/60 backdrop-blur-md rounded-2xl flex gap-1 shadow-inner border border-slate-200/50 animate-in zoom-in-95 duration-500">
        <button id="tabBtnBook" onclick="switchTab('book')" class="flex-1 py-3.5 px-6 rounded-[14px] text-sm font-extrabold flex items-center justify-center gap-2.5 transition-all tab-active">
            <i data-lucide="search" class="w-4 h-4"></i> Find Doctor
        </button>
        <button id="tabBtnTrack" onclick="switchTab('track')" class="flex-1 py-3.5 px-6 rounded-[14px] text-sm font-bold flex items-center justify-center gap-2.5 transition-all tab-inactive">
            <i data-lucide="activity" class="w-4 h-4"></i> Live Queue
        </button>
    </div>

    <!-- Search Form Card -->
    <div class="fade-in animate-in slide-in-from-bottom-8 duration-700">
        <div class="bg-white/90 backdrop-blur-xl border border-white/40 rounded-[2.5rem] p-8 md:p-12 shadow-[0_8px_30px_rgb(0,0,0,0.06)]">
            <div class="flex items-center gap-4 mb-8">
                <div class="w-12 h-12 rounded-2xl bg-orange-50 flex items-center justify-center shrink-0 border border-orange-100/50">
                    <i data-lucide="calendar-check-2" id="formIcon" class="w-6 h-6 text-[#f26522]"></i>
                </div>
                <div>
                    <h2 id="formTitle" class="text-2xl font-black text-slate-800">Book an Appointment</h2>
                    <p id="formSubtitle" class="text-sm font-medium text-slate-500">Select your preferences to see available specialists.</p>
                </div>
            </div>

            <form id="searchForm" action="/Home/Booking" method="get" class="space-y-5">

                <!-- District Dropdown -->
                <div class="relative group">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <i data-lucide="map" class="w-5 h-5 text-slate-400 group-focus-within:text-[#f26522] transition-colors"></i>
                    </div>
                    <select name="did" id="districtDd" required class="w-full pl-12 pr-4 py-4 bg-slate-50/50 border border-slate-200 rounded-2xl text-sm font-semibold text-slate-800 outline-none focus:border-[#f26522] focus:bg-white focus:ring-4 focus:ring-[#f26522]/10 transition-all hover:border-slate-300 disabled:opacity-50 disabled:bg-slate-50 disabled:cursor-not-allowed">
                        <option value="">Choose District</option>
                        @foreach (var d in Model)
                        {
                            <option value="@d.Did">@d.Dname</option>
                        }
                    </select>
                </div>

                <!-- Location Dropdown -->
                <div class="relative group">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <i data-lucide="map-pin" class="w-5 h-5 text-slate-400 group-focus-within:text-[#f26522] transition-colors"></i>
                    </div>
                    <select name="cid" id="locationDd" disabled required class="w-full pl-12 pr-4 py-4 bg-slate-50/50 border border-slate-200 rounded-2xl text-sm font-semibold text-slate-800 outline-none focus:border-[#f26522] focus:bg-white focus:ring-4 focus:ring-[#f26522]/10 transition-all hover:border-slate-300 disabled:opacity-50 disabled:bg-slate-50 disabled:cursor-not-allowed">
                        <option value="">Select Area</option>
                    </select>
                </div>

                <!-- Department Dropdown -->
                <div class="relative group">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <i data-lucide="stethoscope" class="w-5 h-5 text-slate-400 group-focus-within:text-[#f26522] transition-colors"></i>
                    </div>
                    <select name="depid" id="deptDd" disabled required class="w-full pl-12 pr-4 py-4 bg-slate-50/50 border border-slate-200 rounded-2xl text-sm font-semibold text-slate-800 outline-none focus:border-[#f26522] focus:bg-white focus:ring-4 focus:ring-[#f26522]/10 transition-all hover:border-slate-300 disabled:opacity-50 disabled:bg-slate-50 disabled:cursor-not-allowed">
                        <option value="">Select Specialization</option>
                    </select>
                </div>

                <!-- Submit Button -->
                <button type="submit" id="searchBtn" class="w-full bg-gradient-to-r from-[#f26522] to-[#e05615] hover:from-[#d95318] hover:to-[#c64810] text-white px-5 py-4 rounded-2xl font-bold shadow-[0_8px_20px_-4px_rgba(242,101,34,0.4)] hover:shadow-[0_12px_25px_-4px_rgba(242,101,34,0.5)] transform hover:-translate-y-0.5 mt-8 transition-all flex items-center justify-center gap-3 text-lg border border-orange-500/20">
                    Search Doctors <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </button>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        lucide.createIcons();

        function switchTab(t) {
            const btnBook = document.getElementById('tabBtnBook');
            const btnTrack = document.getElementById('tabBtnTrack');

          
            if (t === 'book') {
                btnBook.className = 'flex-1 py-3.5 px-6 rounded-[14px] text-sm font-extrabold flex items-center justify-center gap-2.5 transition-all tab-active';
                btnTrack.className = 'flex-1 py-3.5 px-6 rounded-[14px] text-sm font-bold flex items-center justify-center gap-2.5 transition-all tab-inactive';
            } else {
                btnBook.className = 'flex-1 py-3.5 px-6 rounded-[14px] text-sm font-bold flex items-center justify-center gap-2.5 transition-all tab-inactive';
                btnTrack.className = 'flex-1 py-3.5 px-6 rounded-[14px] text-sm font-extrabold flex items-center justify-center gap-2.5 transition-all tab-active';
            }

            const form = document.getElementById('searchForm');
            const btn = document.getElementById('searchBtn');
            const title = document.getElementById('formTitle');
            const subtitle = document.getElementById('formSubtitle');
            const icon = document.getElementById('formIcon');

          
            if (t === 'book') {
                form.action = '/Home/Booking';
                btn.innerHTML = 'Search Doctors <i data-lucide="arrow-right" class="w-5 h-5"></i>';
                title.textContent = 'Book an Appointment';
                subtitle.textContent = 'Select your preferences to see available specialists.';
                icon.setAttribute('data-lucide', 'calendar-check-2');
            } else {
                form.action = '/Home/LiveQueue';
                btn.innerHTML = 'View Live Queue <i data-lucide="arrow-right" class="w-5 h-5"></i>';
                title.textContent = 'Check Live Queue';
                subtitle.textContent = 'Select a location to view the current token status.';
                icon.setAttribute('data-lucide', 'activity');
            }

            lucide.createIcons();
        }

        const d = document.getElementById('districtDd');
        const l = document.getElementById('locationDd');
        const dep = document.getElementById('deptDd');

        d.onchange = async () => {
            l.disabled = !d.value;
            l.innerHTML = '<option value="">Select Area</option>';
            dep.disabled = true;
            dep.innerHTML = '<option value="">Select Specialization</option>';
            if (d.value) {
                const r = await fetch(`/Home/GetLocations?did=${d.value}`);
                const dt = await r.json();
                dt.forEach(i => l.innerHTML += `<option value="${i.id}">${i.name}</option>`);
            }
        };

        l.onchange = async () => {
            dep.disabled = !l.value;
            dep.innerHTML = '<option value="">Select Specialization</option>';
            if (l.value) {
                const r = await fetch(`/Home/GetDepartments?cid=${l.value}`);
                const dt = await r.json();
                dt.forEach(i => dep.innerHTML += `<option value="${i.id}">${i.name}</option>`);
            }
        };
    </script>
}