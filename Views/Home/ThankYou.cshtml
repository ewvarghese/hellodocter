@{ ViewData["Title"] = "Appointment Confirmed"; }
<main role="main" class="mt-24 mb-16 max-w-3xl mx-auto px-6">
    <div class="bg-white rounded-[2rem] p-10 shadow-xl shadow-slate-200/40 border border-slate-100 text-center">
        <div class="w-24 h-24 bg-green-50 text-green-500 rounded-full flex items-center justify-center mx-auto mb-8">
            <i data-lucide="check-circle" class="w-12 h-12"></i>
        </div>
        <h2 class="text-2xl md:text-3xl font-black text-[#f26522] uppercase mb-8 tracking-wide">
            Doctor Appointment
        </h2>
        
        @if (TempData["doctorName"] != null)
        {
            <p class="text-xl md:text-2xl font-bold text-green-600 leading-relaxed max-w-2xl mx-auto">
                Your appointment is successfully done for <span class="text-slate-800">@TempData["doctorName"]</span> 
                on <span class="text-slate-800">@TempData["aptmtDate"]</span> 
                at <span class="text-slate-800">@TempData["slotTime"]</span> 
                with token number <span class="text-slate-800">@TempData["token"]</span>
            </p>
        }
        else
        {
            <p class="text-xl md:text-2xl font-bold text-green-600">Your appointment is successfully done!</p>
        }
        
        <div class="mt-12">
            <a href="/" class="inline-block bg-[#f26522] text-white px-5 py-3.5 font-bold rounded-2xl shadow-lg hover:bg-orange-600 transition-colors">Back to Home</a>
        </div>
    </div>
</main>
