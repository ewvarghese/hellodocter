@{
    ViewData["Title"] = "Live Queue Status";
}

<main class="max-w-6xl mx-auto px-6 py-8">
    <div class="flex items-center gap-4 mb-8">
        <a href="/" class="inline-flex items-center justify-center w-11 h-11 bg-white border border-slate-200 rounded-xl shadow-sm hover:bg-slate-50 text-slate-600 transition-colors shrink-0" title="Back to Home">
            <i data-lucide="arrow-left" class="w-5 h-5"></i>
        </a>
        <h1 class="text-2xl font-extrabold text-slate-900">
            Live Queue in <span class="text-[#f26522]">@ViewBag.LocationName</span>
        </h1>
    </div>

    <div id="doctorList" class="space-y-4"></div>
</main>

 
@section Scripts {
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const did = urlParams.get('did');
        const cid = urlParams.get('cid');
        const depid = urlParams.get('depid');

        async function load() {
            const res = await fetch(`/Home/GetDoctors?did=${did}&cid=${cid}&depid=${depid}`);
            const data = await res.json();
            const list = document.getElementById('doctorList');

            if (data.length === 0) list.innerHTML = '<div class="p-8 text-center font-bold">No doctors found.</div>';
            else list.innerHTML = ''; 

            data.forEach(doc => {
                list.innerHTML += `
                    <div class="bg-white border border-slate-200 rounded-[1.5rem] p-6 flex flex-col md:flex-row items-center gap-6 shadow-sm card-hover">
                        <div class="w-20 h-20 bg-slate-100 rounded-full overflow-hidden shrink-0">
                            <img src="${doc.photo ? '/images/' + doc.photo : 'https://ui-avatars.com/api/?name=Dr&background=f1f5f9&color=64748b&size=400'}" class="w-full h-full object-cover">
                        </div>
                        <div class="flex-1 text-center md:text-left">
                            <h2 class="text-lg font-bold text-slate-900">${doc.name}</h2>
                            <p class="text-sm font-semibold text-slate-500">${doc.deptName}</p>
                        </div>
                        <div class="md:w-64 flex flex-col items-center justify-center bg-orange-50 rounded-2xl p-4 border border-orange-100">
                            <p class="text-xs font-black text-orange-600 uppercase tracking-widest mb-1">Current Token</p>
                            <p class="text-4xl font-black text-slate-900">#${doc.liveToken || 0}</p>
                        </div>
                    </div>`;
            });

            lucide.createIcons();
        }

        load(); 
        setInterval(load, 5000); 
    </script>
}