@model HelloDoctor.Care.Models.Doctor
@{ 
    ViewData["Title"] = "Live Queue - Dr. " + Model.Drname; 
    int liveToken = ViewBag.LiveToken ?? 0;
}

<style>
    /* Decorative Background */
    .ambient-bg {
        position: fixed;
        inset: 0;
        z-index: -10;
        background-color: #ffffff;
        background-image: radial-gradient(at 100% 0%, hsla(23, 89%, 54%, 0.08) 0px, transparent 50%),
                          radial-gradient(at 0% 100%, hsla(215, 100%, 60%, 0.05) 0px, transparent 50%);
    }
    .grid-pattern {
        position: fixed;
        inset: 0;
        z-index: -10;
        background-size: 40px 40px;
        background-image: linear-gradient(to right, rgba(0, 0, 0, 0.02) 1px, transparent 1px),
                          linear-gradient(to bottom, rgba(0, 0, 0, 0.02) 1px, transparent 1px);
        mask-image: linear-gradient(to bottom, transparent, black, transparent);
        -webkit-mask-image: linear-gradient(to bottom, transparent, black, transparent);
    }
</style>

<!-- Backgrounds -->
<div class="ambient-bg"></div>
<div class="grid-pattern"></div>

<main class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-20 relative z-10">
    
    <div class="flex items-center gap-4 mb-8 animate-in slide-in-from-top-4 duration-500">
        <button onclick="window.location.href='/';" class="inline-flex items-center justify-center w-11 h-11 bg-white/80 backdrop-blur-md border border-slate-200/60 rounded-xl shadow-sm hover:bg-orange-50 hover:text-[#f26522] hover:border-orange-200 text-slate-600 transition-all shrink-0" title="Back to Home">
            <i data-lucide="arrow-left" class="w-5 h-5"></i>
        </button>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">
            Live Queue Status
        </h1>
    </div>

    <!-- Doctor Profile & Token Card -->
    <section class="relative bg-white/90 backdrop-blur-xl border border-white/40 rounded-[2.5rem] p-8 md:p-12 shadow-[0_8px_30px_rgb(0,0,0,0.06)] overflow-hidden animate-in slide-in-from-bottom-8 duration-700">
        
        <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-br from-orange-100 to-transparent rounded-full blur-3xl -mr-20 -mt-20 opacity-60 pointer-events-none"></div>
        
        <div class="flex flex-col md:flex-row items-center md:items-start gap-10 relative z-10">
            <!-- Image -->
            <div class="relative shrink-0">
                <div class="w-32 h-32 md:w-40 md:h-40 rounded-[2rem] overflow-hidden border-[4px] border-white shadow-xl bg-slate-50">
                    <img src="@(!string.IsNullOrEmpty(Model.Photo) ? "/images/" + Model.Photo : "https://ui-avatars.com/api/?name=Dr&background=fff7ed&color=f26522&size=400")" class="w-full h-full object-cover">
                </div>
            </div>

            <!-- Details -->
            <div class="text-center md:text-left flex-1 w-full">
                <h2 class="text-3xl font-black text-slate-900 tracking-tight mb-2"> @Model.Drname</h2>
                <p class="text-[#f26522] font-bold text-lg mb-4">@Model.Department?.Depname</p>
                
                <div class="flex flex-col gap-3 text-sm font-medium text-slate-600 mb-8">
                    @if (!string.IsNullOrEmpty(Model.Designation))
                    {
                        <div class="flex items-center justify-center md:justify-start gap-2">
                            <i data-lucide="award" class="w-4 h-4 text-slate-400"></i> @Model.Designation
                        </div>
                    }
                    <div class="flex items-center justify-center md:justify-start gap-2">
                        <i data-lucide="map-pin" class="w-4 h-4 text-slate-400"></i> @Model.Address, @Model.Location?.Cname
                    </div>
                </div>

                <!-- Live Token Status -->
                <div class="bg-orange-50/80 border border-orange-200/60 p-6 rounded-[1.5rem] flex flex-col sm:flex-row items-center justify-between gap-6 shadow-inner">
                    <div class="text-center sm:text-left">
                        <div class="flex items-center justify-center sm:justify-start gap-2 mb-1">
                            <div class="w-2.5 h-2.5 bg-[#f26522] rounded-full animate-pulse"></div>
                            <span class="text-xs font-black text-[#f26522] uppercase tracking-widest">Live Status</span>
                        </div>
                        <p class="text-slate-800 font-semibold">Currently serving Token Number</p>
                    </div>
                    
                    <div class="bg-white px-8 py-4 rounded-2xl shadow-sm border border-slate-100 flex items-center justify-center min-w-[120px]">
                        <span id="liveTokenDisplay" class="text-4xl font-black text-slate-900">#@liveToken</span>
                    </div>
                </div>

                <div class="mt-8 flex justify-center md:justify-start">
                     @{
                          
                     }
                    <a href="/Home/Schedule?drid=@Model.Drid" class="w-full sm:w-auto bg-gradient-to-r from-[#f26522] to-[#e05615] hover:from-[#d95318] hover:to-[#c64810] text-white px-8 py-4 rounded-2xl font-bold shadow-[0_8px_20px_-4px_rgba(242,101,34,0.4)] hover:shadow-[0_12px_25px_-4px_rgba(242,101,34,0.5)] transform hover:-translate-y-0.5 transition-all flex items-center justify-center gap-3 text-lg border border-orange-500/20">
                        Book Appointment <i data-lucide="arrow-right" class="w-5 h-5"></i>
                    </a>
                </div>

            </div>
        </div>
    </section>
</main>

 
@section Scripts {
    <script>
        lucide.createIcons();

       
        setInterval(async () => {
            try {
                 
                const res = await fetch(`/Home/GetDoctorLiveToken?username=@Model.Mob2`);
                if (res.ok) {
                    const data = await res.json();
                    document.getElementById('liveTokenDisplay').textContent = '#' + data.liveToken;
                }
            } catch (err) {
                console.error("Failed to fetch live token", err);
            }
        }, 5000);
    </script>
}