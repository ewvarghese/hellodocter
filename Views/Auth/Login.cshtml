@{ ViewData["Title"] = "Admin Sign In"; }
<main class="max-w-md mx-auto px-6 py-16 relative">
    <div class="bg-white border border-slate-200 rounded-[2.5rem] p-8 md:p-10 shadow-xl shadow-slate-200/40 relative z-10">
        <h2 class="text-2xl font-black text-slate-900 uppercase tracking-wide mb-2">Sign in now</h2>
        <p class="text-sm text-slate-500 font-semibold mb-8">Access the Appointment Portal</p>
        
        @if(ViewBag.Error != null) {
            <div class="mb-5 p-4 bg-red-50 border border-red-100 text-red-600 rounded-2xl text-sm font-bold flex items-center gap-3">
                <i data-lucide="alert-circle" class="w-5 h-5"></i> @ViewBag.Error
            </div>
        }

        <form action="/Auth/Login" method="post" class="space-y-5">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div>
                <input type="text" name="username" placeholder="User ID" required autofocus class="w-full px-5 py-3.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 placeholder-slate-400 outline-none focus:border-[#f26522] focus:ring-4 focus:ring-[#f26522]/10 transition-all shadow-sm hover:border-slate-300">
            </div>
            <div>
                <input type="password" name="password" placeholder="Password" required class="w-full px-5 py-3.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 placeholder-slate-400 outline-none focus:border-[#f26522] focus:ring-4 focus:ring-[#f26522]/10 transition-all shadow-sm hover:border-slate-300">
            </div>
            
            <div class="flex justify-end mt-2">
                <button type="button" onclick="toggleForgotModal(true)" class="text-sm font-bold text-slate-500 hover:text-[#f26522] transition-colors">
                    Forgot Password?
                </button>
            </div>

            <button type="submit" class="w-full bg-[#10b981] text-white px-5 py-3.5 rounded-xl text-sm font-black uppercase tracking-widest shadow-lg shadow-emerald-500/20 hover:bg-emerald-600 transition-colors mt-4 flex items-center justify-center gap-2">
                <i data-lucide="lock" class="w-4 h-4"></i> Sign In
            </button>
        </form>
    </div>

    <div id="forgotPwdModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center">
        <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="toggleForgotModal(false)"></div>
        <div class="relative bg-white w-full max-w-md mx-6 rounded-[2rem] p-8 shadow-2xl animate-in fade-in zoom-in duration-200">
            <button type="button" onclick="toggleForgotModal(false)" class="absolute top-6 right-6 text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-6 h-6"></i>
            </button>
            <h3 class="text-xl font-black text-slate-900 mb-2">Forgot Password?</h3>
            <p class="text-sm font-semibold text-slate-500 mb-6">Enter your e-mail address below to reset your password.</p>
            
            <form action="/Auth/ForgotPassword" method="post" class="space-y-4">
                <input type="email" name="email" required placeholder="Email Address" class="w-full p-4.5 bg-slate-50 border border-slate-200 rounded-2xl outline-none focus:border-blue-500 transition-all font-semibold">
                
                <div class="flex gap-3 pt-2">
                    <button type="button" onclick="toggleForgotModal(false)" class="flex-1 py-4 text-slate-600 font-bold bg-slate-100 hover:bg-slate-200 rounded-2xl transition-colors">Cancel</button>
                    <button type="submit" class="flex-1 py-4 text-white font-bold bg-[#10b981] hover:bg-emerald-600 rounded-2xl transition-colors shadow-lg shadow-emerald-600/20">Submit</button>
                </div>
            </form>
        </div>
    </div>
</main>

@section Scripts {
<script>
    function toggleForgotModal(show) {
        const modal = document.getElementById('forgotPwdModal');
        if(show) modal.classList.remove('hidden');
        else modal.classList.add('hidden');
    }
</script>
}
