@model HelloDoctor.Care.Models.Role
@{ ViewData["Title"] = "Create Role"; }
<main class="max-w-lg mx-auto px-6 py-16">
    <div class="bg-white border border-slate-200 rounded-[2.5rem] p-8 md:p-10 shadow-xl shadow-slate-200/40">
        <div class="flex items-center gap-4 mb-8">
            <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center"><i data-lucide="shield-check" class="w-6 h-6"></i></div>
            <div>
                <h2 class="text-2xl font-black text-slate-900">Create Role</h2>
                <p class="text-sm font-bold text-slate-400">Add a new role to tbl_roles</p>
            </div>
        </div>
        
        <form action="/Auth/CreateRole" method="post" class="space-y-5">
            <div class="grid grid-cols-2 gap-5">
                <div class="col-span-2">
                    <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Role ID (Primary Key)</label>
                    <input type="number" name="Roleid" required class="w-full p-4.5 bg-slate-50 border border-slate-200 rounded-2xl outline-none focus:border-blue-500 transition-all" placeholder="e.g. 1">
                </div>
                <div class="col-span-2">
                    <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Role Name</label>
                    <input type="text" name="Rolename" required class="w-full p-4.5 bg-slate-50 border border-slate-200 rounded-2xl outline-none focus:border-blue-500 transition-all" placeholder="e.g. Administrator">
                </div>
                <div class="col-span-2">
                    <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Update Note</label>
                    <input type="text" name="Updte" class="w-full p-4.5 bg-slate-50 border border-slate-200 rounded-2xl outline-none focus:border-blue-500 transition-all" placeholder="e.g. Initial setup">
                </div>
                <div>
                    <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Assigned User ID</label>
                    <input type="number" name="Userid" class="w-full p-4.5 bg-slate-50 border border-slate-200 rounded-2xl outline-none focus:border-blue-500 transition-all" placeholder="e.g. 101">
                </div>
                <div class="flex items-center pt-8">
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" name="Actv" value="true" class="w-5 h-5 rounded-lg border-slate-300 text-blue-600 focus:ring-blue-500 outline-none">
                        <span class="text-sm font-bold text-slate-700">Set as Active</span>
                    </label>
                </div>
            </div>
            
            <button type="submit" class="w-full bg-slate-900 text-white p-4.5 rounded-2xl font-black shadow-lg shadow-slate-900/20 hover:bg-slate-800 transition-colors mt-6">Save Role</button>
        </form>
    </div>
</main>
